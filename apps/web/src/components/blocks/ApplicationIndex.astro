---
/**
 * The application example grid.
 *
 * Unlike the service index, the entries are not restated in the CMS: an example
 * is a page in `src/content/applications/`, and this block draws whatever is
 * there. An editor places the block and writes its heading; adding an example
 * is adding a content file, and it appears here on the next build.
 */
import CaptionHeading from '../CaptionHeading.astro'
import Picture from '../Picture.astro'
import SectionHeader from '../SectionHeader.astro'
import { applicationSummaries } from '@/lib/application-pages'
import { authoredMedia } from '@/lib/authored-content'

interface Props {
  eyebrow?: string
  heading?: string
  intro?: string
  footnote?: string
}

const { eyebrow, heading, intro, footnote } = Astro.props

const items = applicationSummaries
const pad = (value: number) => String(value).padStart(2, '0')
---

{
  items.length > 0 && (
    <section class="relative border-t border-gray-100 bg-gray-50/60 px-6 py-28 md:px-12 lg:py-40">
      <div class="relative mx-auto max-w-7xl">
        {(heading || intro) && (
          <SectionHeader
            eyebrow={eyebrow}
            heading={heading}
            intro={intro}
            align="split"
            introCollapseHeight={160}
          />
        )}

        <div
          data-reveal-stagger
          class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8"
        >
          {items.map((item, index) => (
            <a
              href={item.href}
              data-reveal="lift"
              class="group/card relative flex flex-col overflow-hidden rounded-[26px] border border-gray-100 bg-white transition-all duration-500 hover:border-general-red/25 hover:shadow-[0_28px_60px_-24px_rgba(237,28,37,0.28)]"
            >
              {/* The photograph is decoration, not information — every card
                  reads the same without it, so it carries no alt text of its
                  own and the heading below is the link's accessible name. */}
              <span class="relative block aspect-[16/10] overflow-hidden bg-gray-100">
                {item.image && (
                  <Picture
                    media={authoredMedia(item.image)}
                    sizes="(min-width: 1024px) 25rem, (min-width: 640px) 45vw, 90vw"
                    class="h-full w-full object-cover transition-transform duration-[900ms] group-hover/card:scale-[1.06]"
                  />
                )}
                <span
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-general-black/45 via-general-black/5 to-transparent"
                  aria-hidden="true"
                />
                <span
                  class="pointer-events-none absolute bottom-4 left-5 select-none text-[13px] font-black tracking-[0.18em] text-white/70"
                  aria-hidden="true"
                >
                  {pad(index + 1)}
                </span>
              </span>

              <span class="flex flex-1 flex-col p-7 md:p-8">
                <CaptionHeading
                  text={item.title}
                  class="text-[19px] font-black leading-[1.2] tracking-[-0.02em] text-general-black transition-colors duration-300 group-hover/card:text-general-red"
                />

                <span class="mt-3 block text-[14.5px] leading-[1.75] text-general-black">
                  {item.blurb}
                </span>

                {item.sectors.length > 0 && (
                  <span class="mt-6 flex flex-wrap gap-2">
                    {item.sectors.map((sector) => (
                      <span class="rounded-full border border-gray-100 bg-gray-50 px-3 py-1 text-[11.5px] font-bold uppercase tracking-[0.12em] text-general-black">
                        {sector}
                      </span>
                    ))}
                  </span>
                )}

                <span class="mt-7 flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.16em] text-general-red">
                  See how it works
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform duration-300 group-hover/card:translate-x-1"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </span>
              </span>
            </a>
          ))}
        </div>

        {footnote && (
          <p class="mt-12 max-w-3xl text-[14px] leading-[1.8] text-general-black">{footnote}</p>
        )}
      </div>
    </section>
  )
}
