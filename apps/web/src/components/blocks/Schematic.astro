---
/**
 * A process schematic in the style of an instrument maker's application sheet.
 *
 * The plant is laid out as it stands — tanks, machines and panels placed where
 * the story needs them, joined by pipes coloured by what they carry — and
 * every measuring point is a lettered bubble (F flow, T temperature, P
 * pressure, L level, A analysis…) on a leader line to where it taps in. A plant
 * engineer reads that convention without being taught it, and recognises their
 * own plant before reading a word about ours.
 *
 * Coordinates are in the drawing's own units (`width` × `height`, default
 * 1000 × 720). Each bubble points at an entry in `key` by its 1-based number,
 * and the key below the drawing says what that point is for; hovering either
 * lights the other. The drawing is decorative for a screen reader, since the
 * key carries the same information as a list.
 */
import SectionHeader from '../SectionHeader.astro'
import { DRAW, medium as mediumOf, pipePath, type Equipment } from '@/lib/schematic-symbols'

type Point = [number, number]

export interface SchematicEquipment extends Equipment {
  id?: string
  label?: string
  /** Where the label sits; a leader is drawn from it to `leader` if given. */
  labelAt?: Point
  leader?: Point
}

export interface SchematicLine {
  id?: string
  medium: string
  points: Point[]
  arrow?: 'end' | 'start' | 'both' | 'none'
  /** `signal` draws a thin dashed control line instead of a pipe. */
  kind?: 'pipe' | 'signal'
}

export interface SchematicInstrument {
  id?: string
  tag: string
  sub?: string
  x: number
  y: number
  /** The leader, from the bubble to the tapping point, as corner points. */
  path?: Point[]
  key?: number
}

export interface SchematicLabel {
  id?: string
  x: number
  y: number
  text: string
  anchor?: 'start' | 'middle' | 'end'
  strong?: boolean
}

export interface SchematicKey {
  id?: string
  tag: string
  sub?: string
  title: string
  note?: string
}

interface Props {
  id?: string
  eyebrow?: string
  heading?: string
  intro?: string
  title?: string
  key?: SchematicKey[]
  /** The geometry, held by the CMS as one JSON document. */
  drawing?: {
    width?: number
    height?: number
    equipment?: SchematicEquipment[]
    lines?: SchematicLine[]
    instruments?: SchematicInstrument[]
    labels?: SchematicLabel[]
    /** Names for the pipe legend, where the default name for a medium is wrong. */
    mediaNames?: Record<string, string>
  } | null
  footnote?: string
}

const {
  id = 'schematic',
  eyebrow,
  heading,
  intro,
  title,
  key = [],
  drawing,
  footnote,
} = Astro.props

const {
  width = 1000,
  height = 720,
  equipment = [],
  lines = [],
  instruments = [],
  labels = [],
  mediaNames = {},
} = drawing ?? {}

// Gradient ids are per drawing, so two on one page cannot share a definition.
const uid = `sx-${id.replace(/[^a-z0-9]/gi, '').slice(-10)}`
const ref = (name: string) => `url(#${uid}-${name})`

const used = [...new Set(lines.filter((l) => l.kind !== 'signal').map((l) => l.medium))]
const liquids = [...new Set(equipment.map((e) => e.medium).filter(Boolean) as string[])]

const DEFAULT_NAMES: Record<string, string> = {
  product: 'Product',
  steam: 'Steam',
  condensate: 'Condensate',
  water: 'Water',
  'hot-water': 'Hot water',
  air: 'Ambient air',
  'compressed-air': 'Compressed air',
  chemical: 'Chemical',
  gas: 'Gas',
  refrigerant: 'Refrigerant',
  wastewater: 'Wastewater',
  fuel: 'Fuel',
}
const nameOf = (m: string) => mediaNames[m] ?? DEFAULT_NAMES[m] ?? m
const hasSignal = lines.some((l) => l.kind === 'signal')
const hasFitted = equipment.some((e) => e.fitted)

const TITLE_H = title ? 56 : 0
---

<section class="relative border-t border-gray-100 bg-white px-6 py-16 md:px-12 lg:py-20" data-schematic>
  <div class="relative mx-auto max-w-7xl">
    {
      (heading || intro) && (
        <SectionHeader
          eyebrow={eyebrow}
          heading={heading}
          intro={intro}
          align="split"
          introCollapseHeight={200}
        />
      )
    }

    <figure
      class="overflow-hidden rounded-[20px] border border-[#d5dde5] bg-[#e9eef3] lg:grid lg:grid-cols-[minmax(0,1fr)_320px]"
    >
      {/* Drawing and legend on the left; on a wide screen the key sits beside
          them rather than under, so the section is no taller than the drawing. */}
      <div class="flex min-w-0 flex-col">
      {/* Scales with its container at every width, and never grows taller than
          most of a screen, so the whole plant is in view without scrolling
          past it; the key below carries the detail when the drawing is small. */}
      <div class="relative flex flex-1 items-center">
        <svg
          class="schematic mx-auto block h-auto max-h-[min(60vh,500px)] w-full"
          preserveAspectRatio="xMidYMid meet"
          viewBox={`0 0 ${width} ${height + TITLE_H}`}
          aria-hidden="true"
        >
          <defs>
            <linearGradient id={`${uid}-metal`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#a9b2bb" />
              <stop offset="0.28" stop-color="#eef1f4" />
              <stop offset="0.42" stop-color="#ffffff" />
              <stop offset="0.7" stop-color="#d0d6dc" />
              <stop offset="1" stop-color="#8d97a1" />
            </linearGradient>
            <linearGradient id={`${uid}-metal-v`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#a9b2bb" />
              <stop offset="0.28" stop-color="#eef1f4" />
              <stop offset="0.42" stop-color="#ffffff" />
              <stop offset="0.7" stop-color="#d0d6dc" />
              <stop offset="1" stop-color="#8d97a1" />
            </linearGradient>
            {
              liquids.map((m) => {
                const [top, bottom] = mediumOf(m).liquid ?? [mediumOf(m).pipe, mediumOf(m).edge]
                return (
                  <linearGradient id={`${uid}-liq-${m}`} x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color={top} />
                    <stop offset="1" stop-color={bottom} />
                  </linearGradient>
                )
              })
            }
            {
              used.map((m) => (
                <marker
                  id={`${uid}-arr-${m}`}
                  viewBox="0 0 12 12"
                  refX="7"
                  refY="6"
                  markerWidth="16"
                  markerHeight="16"
                  markerUnits="userSpaceOnUse"
                  orient="auto-start-reverse"
                >
                  <path d="M0 0L12 6L0 12Z" fill={mediumOf(m).edge} />
                </marker>
              ))
            }
          </defs>

          {
            title && (
              <g>
                <text class="s-title" x="28" y="38">
                  {title}
                </text>
                <path class="s-rule" d={`M28 ${TITLE_H - 6}H${width - 28}`} />
              </g>
            )
          }

          <g transform={`translate(0 ${TITLE_H})`}>
            {/* Pipes first, so they run into the vessels rather than across them. */}
            {
              lines.map((line) => {
                const d = pipePath(line.points)
                if (line.kind === 'signal') return <path class="s-signal" d={d} />
                const m = mediumOf(line.medium)
                const arrow = line.arrow ?? 'end'
                return (
                  <g>
                    <path d={d} stroke={m.edge} class="s-pipe-edge" />
                    <path
                      d={d}
                      stroke={m.pipe}
                      class="s-pipe"
                      marker-end={arrow === 'end' || arrow === 'both' ? ref(`arr-${line.medium}`) : undefined}
                      marker-start={arrow === 'start' || arrow === 'both' ? ref(`arr-${line.medium}`) : undefined}
                    />
                  </g>
                )
              })
            }

            {
              equipment.map((e, i) => {
                const draw = DRAW[e.kind] ?? DRAW.box!
                return (
                  <g class:list={['s-equip', e.fitted && 'is-fitted']} set:html={draw(`${uid}-c${i}`, e, ref)} />
                )
              })
            }

            {
              equipment.map((e) =>
                e.label ? (
                  <g>
                    {e.leader && e.labelAt && (
                      <path class="s-label-leader" d={`M${e.labelAt[0]} ${e.labelAt[1] + 8}L${e.leader[0]} ${e.leader[1]}`} />
                    )}
                    <text
                      class:list={['s-label', e.fitted && 'is-fitted']}
                      x={e.labelAt?.[0] ?? e.x + e.w / 2}
                      y={e.labelAt?.[1] ?? e.y - 14}
                      text-anchor="middle"
                    >
                      {e.label.split('\n').map((line, j) => (
                        <tspan x={e.labelAt?.[0] ?? e.x + e.w / 2} dy={j === 0 ? 0 : 19}>
                          {line}
                        </tspan>
                      ))}
                    </text>
                  </g>
                ) : null,
              )
            }

            {
              labels.map((label) => (
                <text
                  class:list={['s-text', label.strong && 's-strong']}
                  x={label.x}
                  y={label.y}
                  text-anchor={label.anchor ?? 'start'}
                >
                  {label.text}
                </text>
              ))
            }

            {
              instruments.map((ins) => {
                const tap = ins.path?.[ins.path.length - 1]
                return (
                  <g class="s-point" data-key={ins.key}>
                    {ins.path && (
                      <path class="s-leader" d={`M${ins.x} ${ins.y}` + ins.path.map(([x, y]) => `L${x} ${y}`).join('')} />
                    )}
                    {tap && <circle class="s-tap" cx={tap[0]} cy={tap[1]} r="3.5" />}
                    <circle class="s-halo" cx={ins.x} cy={ins.y} r="33" />
                    <circle class="s-bubble" cx={ins.x} cy={ins.y} r="25" />
                    <text class="s-tag" x={ins.x} y={ins.y + (ins.sub ? 3 : 6)} text-anchor="middle">
                      {ins.tag}
                      {ins.sub && (
                        <tspan class="s-sub" dy="5">
                          {ins.sub}
                        </tspan>
                      )}
                    </text>
                  </g>
                )
              })
            }
          </g>
        </svg>

        {/* On a phone the drawing fits but its labels are small, so it opens
            full-screen at a readable size, scrolled sideways inside the dialog. */}
        <button
          type="button"
          class="absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1.5 text-[12px] font-semibold text-general-black shadow-[0_2px_8px_-2px_rgba(0,0,0,0.25)] md:hidden"
          data-schematic-open
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
          </svg>
          Tap to enlarge
        </button>
      </div>

      <dialog class="schematic-dialog m-0 h-full max-h-none w-full max-w-none bg-[#e9eef3] p-0 backdrop:bg-black/60" data-schematic-dialog>
        <div class="sticky left-0 top-0 z-10 flex justify-end p-3">
          <button
            type="button"
            class="rounded-full bg-white px-4 py-2 text-[13px] font-semibold text-general-black shadow"
            data-schematic-close
          >
            Close
          </button>
        </div>
        <div class="overflow-auto px-3 pb-6" data-schematic-zoom></div>
      </dialog>

      {/* What the colours mean, then what each bubble is. */}
      <div class="border-t border-[#d5dde5] bg-white/60 px-4 py-2.5 sm:px-6">
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[12px] font-medium text-general-black">
          {
            used.map((m) => (
              <li class="flex items-center gap-2">
                <span
                  class="block h-[7px] w-7 rounded-full"
                  style={`background:${mediumOf(m).pipe};box-shadow:inset 0 0 0 1.5px ${mediumOf(m).edge}`}
                />
                {nameOf(m)}
              </li>
            ))
          }
          {
            hasSignal && (
              <li class="flex items-center gap-2">
                <span class="block w-7 border-t-2 border-dashed border-[#4b5563]" />
                Signal
              </li>
            )
          }
          <li class="flex items-center gap-2">
            <span class="flex h-5 w-5 items-center justify-center rounded-full border-[1.5px] border-[#4b5563] bg-white text-[9px] font-bold">F</span>
            Measuring point
          </li>
          {
            hasFitted && (
              <li class="flex items-center gap-2">
                <span class="block h-4 w-5 rounded-[3px] border-2 border-general-red bg-white" />
                What we fit
              </li>
            )
          }
        </ul>
      </div>

      </div>

      {
        key.length > 0 && (
          <ol class="grid grid-cols-1 content-center gap-x-4 gap-y-1 border-t border-[#d5dde5] bg-white p-3 sm:grid-cols-2 sm:p-4 lg:grid-cols-1 lg:border-l lg:border-t-0">
            {key.map((item, index) => (
              <li
                class="s-key flex gap-3 rounded-xl px-2.5 py-2 transition-colors"
                data-key={index + 1}
              >
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-[1.5px] border-[#4b5563] bg-white text-[11.5px] font-bold leading-none text-general-black">
                  {item.tag}
                  {item.sub && <sub class="ml-px text-[7px] font-bold">{item.sub}</sub>}
                </span>
                <span class="min-w-0">
                  <span class="block text-[14px] font-bold leading-snug text-general-black">{item.title}</span>
                  {item.note && (
                    <span class="mt-0.5 block text-[12.5px] leading-[1.5] text-general-black">{item.note}</span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        )
      }
    </figure>

    {footnote && (
      <p class="mt-10 max-w-3xl border-l-2 border-general-red pl-5 text-[15px] leading-[1.8] text-general-black">
        {footnote}
      </p>
    )}
  </div>
</section>

<script>
  // The enlarge button copies the drawing into the dialog at a fixed, readable
  // width, rather than keeping a second copy of the SVG in every page.
  document.querySelectorAll<HTMLElement>('[data-schematic]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-schematic-dialog]')
    const zoom = root.querySelector<HTMLElement>('[data-schematic-zoom]')
    const drawing = root.querySelector<SVGElement>('svg.schematic')
    if (!dialog || !zoom || !drawing) return

    root.querySelector('[data-schematic-open]')?.addEventListener('click', () => {
      const copy = drawing.cloneNode(true) as SVGElement
      copy.style.width = '960px'
      copy.style.maxWidth = 'none'
      zoom.replaceChildren(copy)
      dialog.showModal()
    })
    root.querySelector('[data-schematic-close]')?.addEventListener('click', () => dialog.close())
  })

  // Hovering a bubble lights its entry in the key, and the other way round.
  document.querySelectorAll<HTMLElement>('[data-schematic]').forEach((root) => {
    const all = root.querySelectorAll<Element>('[data-key]')
    const light = (k: string | null) =>
      all.forEach((el) => el.classList.toggle('is-lit', k !== null && el.getAttribute('data-key') === k))

    all.forEach((el) => {
      el.addEventListener('mouseenter', () => light(el.getAttribute('data-key')))
      el.addEventListener('mouseleave', () => light(null))
    })
  })
</script>

<style>
  .schematic {
    font-family: inherit;
  }
  .s-title {
    fill: #1f2937;
    font-size: 21px;
    font-weight: 800;
  }
  .s-rule {
    stroke: #aab6c2;
    stroke-width: 1.2;
  }

  .s-pipe-edge {
    fill: none;
    stroke-width: 10;
    stroke-linejoin: round;
  }
  .s-pipe {
    fill: none;
    stroke-width: 6.5;
    stroke-linejoin: round;
  }
  .s-signal {
    fill: none;
    stroke: #4b5563;
    stroke-width: 1.6;
    stroke-dasharray: 7 5;
  }

  .s-equip :global(.e-edge) {
    stroke: #6f7a85;
    stroke-width: 1.3;
  }
  .s-equip :global(.e-line) {
    fill: none;
    stroke: #6f7a85;
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  .s-equip :global(path.e-edge:not([fill])) {
    fill: none;
  }
  .s-equip :global(.e-seam) {
    fill: none;
    stroke: #8d97a1;
    stroke-width: 1;
  }
  .s-equip :global(.e-leg) {
    fill: none;
    stroke: #6f7a85;
    stroke-width: 3;
    stroke-linecap: round;
  }
  .s-equip :global(.e-dark) {
    fill: #7d8791;
  }
  .s-equip :global(.e-panel) {
    fill: #dde2e7;
    stroke: #6f7a85;
    stroke-width: 1.1;
  }
  .s-equip :global(.e-screen) {
    fill: #36414d;
    stroke: #6f7a85;
    stroke-width: 1;
  }
  .s-equip :global(.e-trend) {
    fill: none;
    stroke: #7dd3a8;
    stroke-width: 1.6;
  }
  .s-equip :global(.e-lamp) {
    fill: #9ca3af;
  }
  .s-equip :global(.e-surface) {
    stroke: #ffffff;
    stroke-opacity: 0.55;
    stroke-width: 1.5;
  }
  .s-equip :global(.e-hot) {
    fill: #3a2a24;
    stroke: #6f7a85;
  }
  .s-equip :global(.e-flame) {
    fill: #f59e0b;
    stroke: #ea580c;
    stroke-width: 1.2;
  }
  .s-equip :global(.e-glass) {
    fill: #c9dbe8;
    stroke: #6f7a85;
    stroke-width: 1.1;
  }
  .s-equip :global(.e-shine) {
    fill: none;
    stroke: #ffffff;
    stroke-width: 2;
    opacity: 0.8;
  }
  .s-equip :global(.e-cold) {
    fill: none;
    stroke: #3b82c4;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .s-equip :global(.e-carton) {
    fill: #d9b98a;
    stroke: #9c7c4f;
    stroke-width: 1.1;
  }
  .s-equip :global(.e-beam) {
    fill: none;
    stroke: #ed1c25;
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
  }
  .s-equip :global(.e-mesh) {
    fill: none;
    stroke: #c2a53a;
    stroke-width: 0.9;
  }
  .s-equip :global(.e-frame) {
    fill: none;
    stroke: #b08f1c;
    stroke-width: 3;
  }
  .s-equip :global(.e-poly) {
    fill: #f4f6f8;
  }
  .s-equip :global(.e-cage) {
    fill: none;
    stroke: #6f7a85;
    stroke-width: 1.6;
  }
  .s-equip :global(.e-tyre) {
    fill: #374151;
    stroke: #9ca3af;
    stroke-width: 3;
  }

  .s-equip.is-fitted :global(.e-edge) {
    stroke: #ed1c25;
    stroke-width: 2.4;
  }

  .s-label {
    fill: #374151;
    font-size: 16px;
    font-weight: 500;
  }
  .s-label.is-fitted {
    fill: #ed1c25;
    font-weight: 700;
  }
  .s-label-leader {
    stroke: #8d97a1;
    stroke-width: 1;
  }
  .s-text {
    fill: #374151;
    font-size: 16px;
  }
  .s-strong {
    fill: #111827;
    font-weight: 700;
    font-size: 17px;
  }

  .s-leader {
    fill: none;
    stroke: #6b7280;
    stroke-width: 1.3;
  }
  .s-tap {
    fill: #ffffff;
    stroke: #4b5563;
    stroke-width: 1.3;
  }
  .s-bubble {
    fill: #ffffff;
    stroke: #4b5563;
    stroke-width: 1.6;
  }
  .s-halo {
    fill: #ed1c25;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .s-tag {
    fill: #111827;
    font-size: 17px;
    font-weight: 700;
  }
  .s-sub {
    font-size: 10px;
  }
  .s-point.is-lit .s-halo {
    opacity: 0.22;
  }
  .s-point.is-lit .s-bubble {
    stroke: #ed1c25;
    stroke-width: 2.4;
  }
  .s-key.is-lit {
    background: #fdecec;
  }
</style>
