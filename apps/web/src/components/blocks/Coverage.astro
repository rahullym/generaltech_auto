---
import ReadMore from '../ReadMore.astro'
import RichText from '../RichText.astro'
import { splitAccent } from '@/lib/accent'
import type { RichTextValue } from '@/lib/types'

interface Props {
  eyebrow?: string
  heading?: string
  /** Dark reads as a full-bleed band; light as a quiet grey one. */
  tone?: 'dark' | 'light'
  note?: string
  areas?: { id?: string; name: string; note?: string }[]
  content?: RichTextValue
}

const { eyebrow, heading, tone = 'dark', note, areas = [], content } = Astro.props

const { lead, accent } = splitAccent(heading)
const dark = tone === 'dark'

// A real map of the Emirates would have to be accurate to be worth drawing, so
// the backdrop is a plain survey grid instead and the areas carry the geography.
const dot = dark ? 'rgba(255,255,255,0.075)' : 'rgba(0,0,0,0.055)'
const fade = 'radial-gradient(ellipse 75% 65% at 50% 45%, #000 0%, transparent 78%)'
---

{/* The section holds the screen: from lg it fills the viewport and centres its
    content, so the reader sees the whole coverage story at once with no band of
    the next section creeping in. The extra top padding is the fixed header: it
    offsets the centring so the content sits in the middle of what is actually
    visible. Below lg it is a normal padded band. */}
<section
  class:list={[
    'coverage-band relative overflow-hidden px-6 py-14 md:px-12 lg:flex lg:min-h-screen lg:items-center',
    dark ? 'bg-general-black text-white' : 'border-t border-gray-100 bg-[#FAFAFA] text-general-black',
  ]}
>
  <div
    class="pointer-events-none absolute inset-0"
    style={`background-image: radial-gradient(${dot} 1px, transparent 1px); background-size: 30px 30px; -webkit-mask-image: ${fade}; mask-image: ${fade}`}
    aria-hidden="true"
  >
  </div>

  {
    dark && (
      <div
        class="pointer-events-none absolute left-1/2 top-0 h-[420px] w-[1000px] max-w-none -translate-x-1/2 -translate-y-1/2 rounded-full opacity-60 blur-[120px]"
        style="background: radial-gradient(circle, rgba(237,28,37,0.30) 0%, rgba(237,28,37,0) 70%)"
        aria-hidden="true"
      />
    )
  }

  <div class="relative mx-auto w-full max-w-7xl">
    <div class="grid gap-x-14 gap-y-10 lg:grid-cols-12 xl:gap-x-20">
      {/* Heading and the response-time claim. */}
      <div class="lg:col-span-5">
        {
          eyebrow && (
            <div class="reveal-item mb-5 flex translate-y-4 items-center gap-3 opacity-0">
              <div class="h-[2px] w-8 bg-general-red" />
              <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-general-red">
                {eyebrow}
              </span>
            </div>
          )
        }

        {
          heading && (
            <h2 class="reveal-item translate-y-8 text-4xl font-black leading-[0.95] tracking-tight opacity-0 sm:text-5xl lg:text-[64px]">
              {lead}
              {accent && <span class="font-medium italic text-general-red"> {accent}</span>}
            </h2>
          )
        }

        {
          note && (
            <div
              class:list={[
                'reveal-item mt-6 flex translate-y-8 items-start gap-4 rounded-2xl border p-5 opacity-0',
                dark ? 'border-white/10 bg-white/[0.03]' : 'border-gray-200 bg-white',
              ]}
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-general-red/10 text-general-red">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </span>

              <p
                class:list={[
                  'text-[15px] leading-[1.8]',
                  dark ? 'text-white/65' : 'text-gray-700',
                ]}
              >
                {note}
              </p>
            </div>
          )
        }
      </div>

      {/* The approved passage, beside the heading rather than under it — the
          only way both fit on screen with the areas. */}
      {
        content && (
          <div class="reveal-item translate-y-8 opacity-0 lg:col-span-7">
            <ReadMore tone={dark ? 'dark' : 'light'} height={230}>
              <RichText value={content} class={dark ? 'prose-invert' : undefined} />
            </ReadMore>
          </div>
        )
      }
    </div>

    {/* The areas, threaded onto one rail: vertical while stacked, horizontal
        once the row fits, with a marker where each one sits on the line. */}
    {
      areas.length > 0 && (
        <div class="mt-12 grid gap-x-10 sm:grid-cols-2 lg:mt-10 lg:grid-cols-4 lg:gap-x-0">
          {areas.map((area, index) => (
            <div
              class:list={[
                'coverage-area group relative border-l pb-8 pl-7 opacity-0 translate-y-8 reveal-item lg:border-l-0 lg:border-t lg:pb-0 lg:pl-0 lg:pr-8 lg:pt-7',
                dark ? 'border-white/12' : 'border-gray-200',
              ]}
              style={`transition-delay: ${index * 70}ms`}
            >
              <span
                class="coverage-marker absolute left-0 top-[7px] h-[10px] w-[10px] -translate-x-1/2 rounded-full bg-general-red lg:left-0 lg:top-0 lg:-translate-y-1/2"
                aria-hidden="true"
              />

              <h3 class="text-[22px] font-bold leading-[1.2] tracking-tight lg:text-2xl">
                {area.name}
              </h3>

              {area.note && (
                <p
                  class:list={[
                    'mt-3 text-[15px] leading-[1.8]',
                    dark ? 'text-white/50' : 'text-gray-600',
                  ]}
                >
                  {area.note}
                </p>
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Vertical padding tracks the viewport height rather than a fixed step, so
     the section still holds the whole screen on a short laptop without pushing
     the areas off it. The top is the heavier side: it offsets the fixed header
     so the content lands in the middle of what is actually visible. */
  @media (min-width: 1024px) {
    .coverage-band {
      padding-top: clamp(5rem, 13vh, 9rem);
      padding-bottom: clamp(1.75rem, 5.5vh, 5rem);
    }
  }

  /* The marker sits on the rail; hovering an area lights it without moving the
     copy, so the row reads as a map legend rather than a set of buttons. */
  .coverage-marker {
    box-shadow: 0 0 0 4px rgba(237, 28, 37, 0.15);
    transition:
      box-shadow 0.4s ease,
      transform 0.4s ease;
  }
  .coverage-area:hover .coverage-marker {
    box-shadow: 0 0 0 7px rgba(237, 28, 37, 0.2);
  }

  /* While the rail is vertical it runs on through the gap below each area, so
     the areas read as stops on one line. The final row has nothing to run on
     to, so its tail is trimmed rather than left dangling. */
  .coverage-area:last-child {
    padding-bottom: 0;
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .coverage-area:nth-last-child(-n + 2) {
      padding-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coverage-marker {
      transition: none;
    }
  }
</style>
