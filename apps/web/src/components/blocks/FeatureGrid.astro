---
import SectionHeader from '../SectionHeader.astro'
import Link from '../Link.astro'
import Picture from '../Picture.astro'
import type { LinkValue, Media } from '@/lib/types'

interface Props {
  heading?: string
  intro?: string
  columns?: '2' | '3' | '4'
  features: {
    id?: string
    icon?: Media | string
    title: string
    description?: string
    link?: LinkValue
  }[]
}

const { heading, intro, columns = '3', features = [] } = Astro.props

const gridCols: Record<string, string> = {
  '2': 'sm:grid-cols-2',
  '3': 'sm:grid-cols-2 lg:grid-cols-3',
  '4': 'sm:grid-cols-2 lg:grid-cols-4',
}
---

<section class="pt-20 lg:pt-32 pb-32 lg:pb-40 bg-white relative border-t border-gray-100 px-6 md:px-12">
  <div class="max-w-7xl mx-auto relative z-10">
    {(heading || intro) && <SectionHeader heading={heading} intro={intro} align="split" sticky />}

    <div class:list={['grid gap-8', gridCols[columns] ?? gridCols['3']]}>
      {
        features.map((feature, index) => (
          <div
            class="group relative flex flex-col rounded-2xl border border-gray-100 bg-white p-10 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl opacity-0 translate-y-8 reveal-item"
            style={`transition-delay: ${index * 50}ms`}
          >
            {feature.icon && typeof feature.icon === 'object' ? (
              <div class="w-16 h-16 rounded-2xl bg-gray-50 flex items-center justify-center mb-8 border border-gray-50 group-hover:border-general-red/20 group-hover:bg-general-red/5 transition-all duration-700">
                <Picture media={feature.icon} class="h-8 w-8 object-contain" />
              </div>
            ) : (
              <span class="text-[11px] font-bold tracking-[0.4em] uppercase text-gray-400 mb-6 group-hover:text-general-red transition-colors">
                {String(index + 1).padStart(2, '0')}
              </span>
            )}

            <div class="w-12 h-[2px] bg-general-red mb-6 group-hover:w-full transition-all duration-700 origin-left" />

            <h3 class="text-2xl lg:text-[26px] font-bold tracking-tight text-general-black leading-[1.1] mb-3">
              {feature.title}
            </h3>

            {feature.description && (
              <p class="text-[15px] text-gray-700 leading-relaxed">{feature.description}</p>
            )}

            {feature.link?.label && (
              <Link
                link={feature.link}
                class="mt-8 inline-flex items-center gap-2 text-[12px] font-bold tracking-[0.1em] uppercase text-general-red hover:text-general-black transition-colors"
              />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
