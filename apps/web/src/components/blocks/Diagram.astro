---
/**
 * A picture of the arrangement.
 *
 * The application pages carry photographs of plants, and a photograph of a
 * plant tells a reader nothing about how the thing works — one refinery looks
 * much like another. This draws the actual arrangement instead.
 *
 * `chain` is the signal path: what measures, what it is wired to, what carries
 * the reading, and where it comes out. The protocol rides on the connector,
 * because "how does it get from the tank to my phone" is the question, and the
 * answer is the arrow rather than the boxes.
 *
 * `groups` is for retrofits, where the path is not the point and the anxiety
 * is. Someone looking at a working machine wants to know what you are going to
 * take out of it, so the diagram is two columns: replaced, and kept.
 *
 * Drawn in HTML rather than as an image so it stays sharp, reflows on a phone,
 * and can be read by a screen reader — the connectors are the only SVG, and
 * they are decorative.
 */
import CaptionHeading from '../CaptionHeading.astro'
import SectionHeader from '../SectionHeader.astro'

interface Props {
  variant?: 'chain' | 'groups'
  eyebrow?: string
  heading?: string
  intro?: string
  nodes?: { id?: string; icon?: string; title: string; note?: string; via?: string }[]
  groups?: {
    id?: string
    title: string
    note?: string
    tone?: 'accent' | 'neutral'
    items: { id?: string; icon?: string; title: string; note?: string }[]
  }[]
  footnote?: string
}

const { variant = 'chain', eyebrow, heading, intro, nodes = [], groups = [], footnote } =
  Astro.props

