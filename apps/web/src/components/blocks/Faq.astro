---
import RichText from '../RichText.astro'
import { splitAccent } from '@/lib/accent'
import { lexicalToText } from '@/lib/lexical'
import type { RichTextValue } from '@/lib/types'

interface Props {
  heading?: string
  items: { id?: string; question: string; answer: RichTextValue }[]
  /** False when the page already publishes its own FAQPage schema. */
  emitSchema?: boolean
}

const { heading, items = [], emitSchema = true } = Astro.props
const { lead, accent } = splitAccent(heading)

// Two balanced columns, as on the generaltech knowledge base.
const half = Math.ceil(items.length / 2)
const columns = [items.slice(0, half), items.slice(half)]

// FAQPage structured data earns rich results in search.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: lexicalToText(item.answer) },
  })),
}
---

<section class="py-32 bg-white overflow-hidden px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    {
      heading && (
        <div class="flex flex-col items-center text-center mb-24 opacity-0 translate-y-8 reveal-item">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-[2px] bg-general-red" />
            <span class="text-[12px] font-bold tracking-[0.2em] uppercase text-general-red">
              Knowledge Base
            </span>
            <div class="w-12 h-[2px] bg-general-red" />
          </div>
          <h2 class="text-5xl lg:text-[72px] font-black tracking-tight text-general-black leading-[0.95] mb-8">
            {lead}
            {accent && (
              <>
                <br />
                <span class="text-general-red italic font-medium">{accent}</span>
              </>
            )}
          </h2>
        </div>
      )
    }

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 xl:gap-x-24 border-t border-gray-200 relative">
      <div class="hidden lg:block absolute top-0 bottom-0 left-1/2 w-[1px] bg-gray-100 -translate-x-1/2"></div>

      {
        columns.map((column) => (
          <div class="flex flex-col">
            {column.map((item) => (
              <div class="border-b border-gray-200/80 faq-item">
                <button
                  type="button"
                  class="w-full py-8 flex items-start justify-between text-left group gap-6 outline-none transition-all duration-300 faq-trigger"
                  aria-expanded="false"
                >
                  <span class="text-[19px] lg:text-[21px] font-bold tracking-tight transition-colors duration-300 pr-4 leading-[1.3] text-general-black group-hover:text-general-red">
                    {item.question}
                  </span>
                  <span class="shrink-0 flex items-center justify-center transition-transform duration-500 mt-1 text-gray-300 group-hover:text-general-red">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="plus-icon" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="minus-icon hidden" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </span>
                </button>
                <div class="overflow-hidden transition-all duration-500 max-h-0 faq-content">
                  <RichText
                    value={item.answer}
                    class="pb-8 pr-8 text-gray-500 text-[16px] leading-relaxed font-light"
                  />
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

{
  emitSchema && items.length > 0 && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )
}

<script>
  // Single-open accordion: opening one answer collapses the rest, matching the
  // generaltech knowledge base. max-height is set in px so it can animate.
  function initFaq() {
    const items = document.querySelectorAll<HTMLElement>('.faq-item')

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger')
      const content = item.querySelector<HTMLElement>('.faq-content')
      if (!trigger || !content) return

      trigger.addEventListener('click', () => {
        const isOpen = content.style.maxHeight !== '0px' && content.style.maxHeight !== ''

        items.forEach((other) => {
          const otherContent = other.querySelector<HTMLElement>('.faq-content')
          if (otherContent) otherContent.style.maxHeight = '0px'
          other.querySelector('.plus-icon')?.classList.remove('hidden')
          other.querySelector('.minus-icon')?.classList.add('hidden')
          other.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false')
        })

        if (!isOpen) {
          content.style.maxHeight = `${content.scrollHeight}px`
          item.querySelector('.plus-icon')?.classList.add('hidden')
          item.querySelector('.minus-icon')?.classList.remove('hidden')
          trigger.setAttribute('aria-expanded', 'true')
        }
      })
    })
  }

  document.addEventListener('astro:page-load', initFaq)
  document.addEventListener('DOMContentLoaded', initFaq)
</script>
