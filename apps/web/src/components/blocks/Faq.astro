---
import RichText from '../RichText.astro'
import SectionHeader from '../SectionHeader.astro'
import { lexicalToText } from '@/lib/lexical'
import type { RichTextValue } from '@/lib/types'

interface Props {
  eyebrow?: string
  heading?: string
  intro?: string
  items: { id?: string; question: string; answer: RichTextValue }[]
  /** False when the page already publishes its own FAQPage schema. */
  emitSchema?: boolean
}

const {
  eyebrow = 'Knowledge Base',
  heading,
  intro,
  items = [],
  emitSchema = true,
} = Astro.props

// Two balanced columns, as on the generaltech knowledge base.
const half = Math.ceil(items.length / 2)
const columns = [items.slice(0, half), items.slice(half)]

// FAQPage structured data earns rich results in search.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: lexicalToText(item.answer) },
  })),
}
---

<section class="overflow-hidden border-t border-gray-100 bg-white px-6 py-28 md:px-12 lg:py-40">
  <div class="mx-auto max-w-7xl">
    {(eyebrow || heading || intro) && (
      <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
    )}

    <div class="relative grid grid-cols-1 border-t border-gray-200 lg:grid-cols-2 lg:gap-x-20 xl:gap-x-28">
      <div
        class="absolute bottom-0 left-1/2 top-0 hidden w-px -translate-x-1/2 bg-gray-100 lg:block"
        aria-hidden="true"
      >
      </div>

      {
        columns.map((column, columnIndex) => (
          <div class="flex flex-col" data-faq-column>
            {column.map((item, index) => {
              const id = `faq-${columnIndex}-${index}`

              return (
                <div class="faq-item border-b border-gray-200/80">
                  <h3>
                    <button
                      type="button"
                      class="faq-trigger group flex w-full items-start justify-between gap-10 py-8 text-left outline-none transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-general-red"
                      aria-expanded="false"
                      aria-controls={`${id}-panel`}
                      id={`${id}-trigger`}
                    >
                      <span class="pr-4 text-[19px] font-bold leading-[1.3] tracking-tight text-general-black transition-colors duration-300 group-hover:text-general-red lg:text-[21px]">
                        {item.question}
                      </span>

                      {/* One glyph rotated 45deg, so plus becomes cross with no icon swap. */}
                      <span
                        class="faq-icon mt-1 flex shrink-0 items-center justify-center text-gray-300 transition-[transform,color] duration-500 group-hover:text-general-red"
                        aria-hidden="true"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="22"
                          height="22"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        >
                          <line x1="12" y1="5" x2="12" y2="19" />
                          <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                      </span>
                    </button>
                  </h3>

                  <div
                    class="faq-content overflow-hidden transition-[max-height] duration-500 ease-out"
                    style="max-height: 0"
                    id={`${id}-panel`}
                    role="region"
                    aria-labelledby={`${id}-trigger`}
                  >
                    <RichText
                      value={item.answer}
                      class="pb-8 pr-8 text-[16px] leading-relaxed text-gray-600"
                    />
                  </div>
                </div>
              )
            })}
          </div>
        ))
      }
    </div>
  </div>
</section>

{
  emitSchema && items.length > 0 && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )
}

<style>
  .faq-item.is-open .faq-icon {
    transform: rotate(45deg);
    color: #ed1c25;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-content,
    .faq-icon {
      transition: none !important;
    }
  }
</style>

<script>
  // Accordion. Opening one answer closes the others *in the same column* only:
  // collapsing an item in the opposite column used to shift the row the reader
  // had just clicked, so the page jumped under the cursor.
  function initFaq() {
    document.querySelectorAll<HTMLElement>('[data-faq-column]').forEach((column) => {
      // Guard: this runs on both DOMContentLoaded and astro:page-load.
      if (column.dataset.faqReady) return
      column.dataset.faqReady = 'true'

      const items = Array.from(column.querySelectorAll<HTMLElement>('.faq-item'))

      const close = (item: HTMLElement) => {
        const content = item.querySelector<HTMLElement>('.faq-content')
        const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger')
        if (!content || !trigger) return

        content.style.maxHeight = '0'
        trigger.setAttribute('aria-expanded', 'false')
        item.classList.remove('is-open')
      }

      const open = (item: HTMLElement) => {
        const content = item.querySelector<HTMLElement>('.faq-content')
        const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger')
        if (!content || !trigger) return

        content.style.maxHeight = `${content.scrollHeight}px`
        trigger.setAttribute('aria-expanded', 'true')
        item.classList.add('is-open')
      }

      items.forEach((item) => {
        const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger')
        if (!trigger) return

        trigger.addEventListener('click', () => {
          const wasOpen = item.classList.contains('is-open')
          items.forEach(close)
          if (!wasOpen) open(item)
        })
      })

      // An open answer measured at one width clips at another.
      window.addEventListener('resize', () => {
        const openItem = items.find((item) => item.classList.contains('is-open'))
        if (!openItem) return
        const content = openItem.querySelector<HTMLElement>('.faq-content')
        if (content) content.style.maxHeight = `${content.scrollHeight}px`
      })
    })
  }

  document.addEventListener('astro:page-load', initFaq)
  document.addEventListener('DOMContentLoaded', initFaq)
</script>
