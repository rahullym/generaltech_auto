---
import CaptionHeading from '../CaptionHeading.astro'
import { splitAccent } from '@/lib/accent'

interface Props {
  eyebrow?: string
  heading?: string
  intro?: string
  steps: { id?: string; title: string; description?: string; meta?: string }[]
  footnote?: string
}

const { eyebrow, heading, intro, steps = [], footnote } = Astro.props
const { lead, accent } = splitAccent(heading)

const total = String(steps.length).padStart(2, '0')
const pad = (value: number) => String(value).padStart(2, '0')
---

{/* An alternating timeline on a central spine. The stages used to run down a
    narrow right-hand column beside a sticky counter, which left the page half
    empty and made six short stages feel like a long list. The spine fills red
    as the reader passes each node. */}
<section class="border-t border-gray-100 bg-white px-6 py-28 md:px-12 lg:py-40" data-process>
  <div class="mx-auto max-w-6xl">
    {/* Header */}
    <div class="mx-auto max-w-3xl text-center">
      {
        eyebrow && (
          <div data-reveal="up" class="mb-6 flex items-center justify-center gap-3">
            <span class="h-[2px] w-8 bg-general-red" aria-hidden="true" />
            <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-general-red">
              {eyebrow}
            </span>
            <span class="h-[2px] w-8 bg-general-red" aria-hidden="true" />
          </div>
        )
      }

      {
        heading && (
          <h2
            data-reveal="mask"
            class="text-[2.75rem] font-extrabold leading-[1.05] tracking-[-0.035em] text-general-black lg:text-[3.5rem]"
          >
            {lead}
            {accent && <span class="font-medium italic text-general-red"> {accent}</span>}
          </h2>
        )
      }

      {
        intro && (
          <p data-reveal="up" class="mx-auto mt-7 max-w-2xl text-[17px] leading-[1.8] text-gray-600">
            {intro}
          </p>
        )
      }

      <div
        data-reveal="up"
        class="mt-8 font-mono text-[12px] font-semibold tracking-[0.18em] text-gray-400"
      >
        <span data-process-current class="text-general-red">01</span> / {total} STAGES
      </div>
    </div>

    {/* Timeline */}
    <ol class="relative mt-20 lg:mt-24" data-process-list>
      {/* Spine: grey track with a red fill that follows the reader. */}
      <span
        class="absolute bottom-0 top-0 w-px bg-gray-200 left-[27px] lg:left-1/2 lg:-translate-x-1/2"
        aria-hidden="true"
      />
      <span
        class="process-fill absolute top-0 w-px origin-top bg-general-red left-[27px] lg:left-1/2 lg:-translate-x-1/2"
        data-process-fill
        aria-hidden="true"
      />

      {
        steps.map((step, index) => {
          const right = index % 2 === 1

          return (
            <li
              class="process-step relative pb-14 last:pb-0 lg:pb-20"
              data-process-step
              data-process-title={step.title}
            >
              <div class="grid grid-cols-1 items-start lg:grid-cols-2 lg:gap-x-20">
                {/* Node sits on the spine at every breakpoint. */}
                <span
                  class="process-node absolute left-[27px] top-1 z-10 flex h-14 w-14 -translate-x-1/2 items-center justify-center border border-gray-200 bg-white text-[13px] font-extrabold tabular-nums text-gray-400 transition-all duration-500 lg:left-1/2 lg:top-0"
                  aria-hidden="true"
                >
                  {pad(index + 1)}
                </span>

                <div
                  data-reveal={right ? 'right' : 'left'}
                  class:list={[
                    'pl-20 lg:pl-0',
                    right ? 'lg:col-start-2 lg:pl-14 lg:text-left' : 'lg:col-start-1 lg:pr-14 lg:text-right',
                  ]}
                >
                  {step.meta && (
                    <span class="mb-3 block text-[11px] font-bold uppercase tracking-[0.2em] text-general-red">
                      {step.meta}
                    </span>
                  )}

                  <CaptionHeading
                    text={step.title}
                    class="text-[1.4rem] font-extrabold leading-[1.2] tracking-[-0.025em] text-general-black lg:text-[1.6rem]"
                  />

                  {step.description && (
                    <p
                      class:list={[
                        'mt-4 text-[15px] leading-[1.85] text-gray-600',
                        right ? 'lg:mr-auto' : 'lg:ml-auto',
                        'lg:max-w-[42ch]',
                      ]}
                    >
                      {step.description}
                    </p>
                  )}
                </div>
              </div>
            </li>
          )
        })
      }
    </ol>

    {
      footnote && (
        <p
          data-reveal="up"
          class="mx-auto mt-16 max-w-3xl border-l-2 border-general-red/20 pl-8 text-[15px] leading-[1.8] text-gray-500"
        >
          {footnote}
        </p>
      )
    }
  </div>
</section>

<style>
  /* The fill grows from the top as the reader descends. */
  .process-fill {
    height: 100%;
    transform: scaleY(0);
    transition: transform 0.25s linear;
  }

  .process-step.is-done .process-node {
    border-color: #ed1c25;
    color: #ed1c25;
  }
  .process-step.is-active .process-node {
    border-color: #ed1c25;
    background: #ed1c25;
    color: #fff;
    box-shadow: 0 12px 30px rgba(237, 28, 37, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .process-fill,
    .process-node {
      transition: none !important;
    }
    .process-fill {
      transform: scaleY(1);
    }
  }
</style>

<script>
  // Drives the spine fill, the node states and the stage counter from scroll
  // position. Without JS the spine stays grey and every stage is still read.
  function initProcess() {
    document.querySelectorAll<HTMLElement>('[data-process]').forEach((section) => {
      // Guard: this runs on both DOMContentLoaded and astro:page-load.
      if (section.dataset.processReady) return
      section.dataset.processReady = 'true'

      const list = section.querySelector<HTMLElement>('[data-process-list]')
      const fill = section.querySelector<HTMLElement>('[data-process-fill]')
      const counter = section.querySelector<HTMLElement>('[data-process-current]')
      const steps = Array.from(section.querySelectorAll<HTMLElement>('[data-process-step]'))
      if (!list || !steps.length) return

      let frame = 0
      let last = -2

      const sync = () => {
        frame = 0

        // The reader is "at" whatever sits just above the middle of the screen.
        const anchor = window.innerHeight * 0.55
        const box = list.getBoundingClientRect()
        const span = Math.max(box.height, 1)
        const filled = Math.min(Math.max(anchor - box.top, 0), span)

        if (fill) fill.style.transform = `scaleY(${filled / span})`

        let active = -1
        steps.forEach((step, index) => {
          const node = step.querySelector<HTMLElement>('.process-node')
          if (node && node.getBoundingClientRect().top <= anchor) active = index
        })

        if (active === last) return
        last = active

        steps.forEach((step, index) => {
          step.classList.toggle('is-active', index === active)
          step.classList.toggle('is-done', index < active)
        })

        if (counter) counter.textContent = String(Math.max(active, 0) + 1).padStart(2, '0')
      }

      const request = () => {
        if (!frame) frame = window.requestAnimationFrame(sync)
      }

      window.addEventListener('scroll', request, { passive: true })
      window.addEventListener('resize', request)
      sync()
    })
  }

  document.addEventListener('astro:page-load', initProcess)
  document.addEventListener('DOMContentLoaded', initProcess)
</script>
