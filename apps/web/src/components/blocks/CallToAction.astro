---
import Button from '../Button.astro'
import { splitAccent } from '@/lib/accent'
import type { LinkValue } from '@/lib/types'

interface Props {
  variant?: 'dark' | 'light' | 'compact'
  eyebrow?: string
  heading: string
  body?: string
  actions?: { id?: string; link: LinkValue }[]
}

const {
  variant = 'dark',
  eyebrow = 'Get in touch',
  heading,
  body,
  actions = [],
} = Astro.props
const { lead, accent } = splitAccent(heading)
---

{
  /* Dark slab: the page's closing statement. Centred, full-bleed black, with a
     faint red bloom so it reads as a destination rather than another band. */
  variant === 'dark' && (
    <section class="relative overflow-hidden border-t border-white/10 bg-general-black px-6 py-32 text-white md:px-12">
      <div
        class="pointer-events-none absolute left-1/2 top-0 h-[420px] w-[820px] max-w-none -translate-x-1/2 -translate-y-1/2 rounded-full opacity-60 blur-[120px]"
        style="background: radial-gradient(circle, rgba(237,28,37,0.35) 0%, rgba(237,28,37,0) 70%)"
        aria-hidden="true"
      />

      <div class="relative mx-auto max-w-7xl">
        <div class="mx-auto mb-16 flex max-w-4xl flex-col items-center text-center">
          <div class="reveal-item mb-8 flex translate-y-4 items-center gap-4 opacity-0">
            <div class="h-[2px] w-12 bg-general-red" />
            <span class="text-[12px] font-bold uppercase tracking-[0.2em] text-general-red">
              {eyebrow}
            </span>
            <div class="h-[2px] w-12 bg-general-red" />
          </div>

          <h2 class="reveal-item mb-10 translate-y-8 text-4xl font-black leading-[0.95] tracking-tight opacity-0 lg:text-[64px]">
            {lead}
            {accent && <span class="font-medium italic text-general-red"> {accent}</span>}
          </h2>

          {body && (
            <div class="reveal-item mx-auto w-full max-w-2xl translate-y-8 border-t border-white/10 pt-8 opacity-0">
              <p class="text-lg leading-relaxed text-white/60">{body}</p>
            </div>
          )}
        </div>

        {actions.length > 0 && (
          <div class="reveal-item flex translate-y-8 flex-col items-center justify-center gap-4 opacity-0 md:flex-row lg:gap-6">
            {actions.map((action) => (
              <Button link={action.link} tone="dark" class="w-full md:w-auto" />
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

{
  /* Dark panel: a contained slab inside the white page. Rounded, red-edged and
     lit from the top so it reads as an inset destination between two light
     bands, rather than breaking the page open the way the full-bleed dark
     variant does. */
  variant === 'light' && (
    <section class="bg-white px-6 py-20 md:px-12 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="reveal-item relative translate-y-8 overflow-hidden rounded-[28px] border border-general-red/25 bg-[#0e0e11] px-6 py-20 text-center text-white opacity-0 md:px-16 md:py-24">
          <div
            class="pointer-events-none absolute inset-x-0 top-0 h-[360px]"
            style="background: radial-gradient(ellipse 60% 100% at 50% 0%, rgba(237,28,37,0.18) 0%, rgba(237,28,37,0) 70%)"
            aria-hidden="true"
          />

          <div class="relative mx-auto flex max-w-3xl flex-col items-center">
            {eyebrow && (
              <div class="mb-6 flex items-center gap-3">
                <div class="h-[2px] w-8 bg-general-red" />
                <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-general-red">
                  {eyebrow}
                </span>
                <div class="h-[2px] w-8 bg-general-red" />
              </div>
            )}

            <h2 class="bg-linear-to-b from-white to-white/60 bg-clip-text text-3xl font-black leading-[1.05] tracking-tight text-transparent sm:text-4xl lg:text-[44px]">
              {lead}
              {accent && <span class="font-medium italic text-general-red"> {accent}</span>}
            </h2>

            {body && <p class="mt-6 text-lg leading-relaxed text-white/60">{body}</p>}

            {actions.length > 0 && (
              <div class="mt-10 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row">
                {actions.map((action) => (
                  <Button
                    link={action.link}
                    tone="dark"
                    class="w-full bg-linear-to-r! from-general-red! to-[#ff5a45]! text-white! shadow-[0_14px_44px_-10px_rgba(237,28,37,0.65)] hover:brightness-110 sm:w-auto"
                  />
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

{
  /* Compact bar: a low-emphasis prompt between two heavy sections. One line,
     no body copy, so it moves the reader on without competing for attention. */
  variant === 'compact' && (
    <section class="bg-white px-6 py-12 md:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="reveal-item flex translate-y-4 flex-col gap-6 rounded-2xl border border-gray-200 bg-gray-50/60 px-8 py-8 opacity-0 md:flex-row md:items-center md:justify-between md:gap-10 md:px-10">
          <div class="flex items-start gap-5 md:items-center">
            <span class="mt-1 h-10 w-[3px] shrink-0 bg-general-red md:mt-0" aria-hidden="true" />
            <div>
              <span class="mb-1 block text-[11px] font-bold uppercase tracking-[0.25em] text-general-red">
                {eyebrow}
              </span>
              <p class="text-xl font-bold leading-[1.25] tracking-tight text-general-black lg:text-2xl">
                {lead}
                {accent && <span class="font-medium italic text-general-red"> {accent}</span>}
              </p>
            </div>
          </div>

          {actions.length > 0 && (
            <div class="flex shrink-0 flex-col gap-3 sm:flex-row md:justify-end">
              {actions.map((action) => (
                <Button link={action.link} class="w-full sm:w-auto" />
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
