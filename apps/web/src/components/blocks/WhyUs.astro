---
import ReadMore from '../ReadMore.astro'
import { splitAccent } from '@/lib/accent'

interface Props {
  eyebrow?: string
  heading?: string
  intro?: string
  proofs?: { id?: string; value: string; label: string }[]
  pillars: { id?: string; title: string; body: string }[]
  footnote?: string
}

const { eyebrow, heading, intro, proofs = [], pillars = [], footnote } = Astro.props
const { lead, accent } = splitAccent(heading)

const pad = (value: number) => String(value).padStart(2, '0')
---

{/* Dark band. "Who We Are" is also dark, but it sits six sections earlier, so
    the two read as punctuation across a long page rather than as a repeat. The
    argument for choosing us leads on the proof figures — the most concrete
    thing on the page — with the three positions set out beneath. */}
<section class="relative overflow-hidden border-t border-white/10 bg-general-black px-6 py-28 text-white md:px-12 lg:py-40">
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[620px] w-[620px] rounded-full opacity-60 blur-[140px]"
    style="background: radial-gradient(circle, rgba(237,28,37,0.28) 0%, rgba(237,28,37,0) 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl">
    {/* Header */}
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        {
          eyebrow && (
            <div data-reveal="up" class="mb-6 flex items-center gap-3">
              <span class="h-[2px] w-8 bg-general-red" aria-hidden="true" />
              <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-general-red">
                {eyebrow}
              </span>
            </div>
          )
        }

        {
          heading && (
            <h2
              data-reveal="mask"
              class="text-[2.75rem] font-extrabold leading-[1.05] tracking-[-0.035em] text-white lg:text-[3.5rem]"
            >
              {lead}
              {accent && <span class="font-medium italic text-general-red"> {accent}</span>}
            </h2>
          )
        }
      </div>

      {
        intro && (
          <div class="lg:col-span-5">
            <p
              data-reveal="up"
              class="border-t-2 border-general-red pt-6 text-[17px] leading-[1.8] text-white/60"
            >
              {intro}
            </p>
          </div>
        )
      }
    </div>

    {/* Proof figures — the lead evidence, given the scale to match. */}
    {
      proofs.length > 0 && (
        <div
          data-reveal-stagger
          class="mt-20 grid grid-cols-2 border-t border-white/15 lg:mt-24 lg:grid-cols-4"
        >
          {proofs.map((proof, index) => (
            <div
              data-reveal="lift"
              class:list={[
                'group border-b border-white/15 px-0 py-10 lg:py-12',
                'lg:border-b-0',
                index > 0 && 'lg:border-l lg:border-white/15 lg:pl-10',
                index % 2 === 1 && 'border-l border-white/15 pl-8 lg:pl-10',
              ]}
            >
              <div class="text-[3.25rem] font-extrabold leading-none tracking-[-0.04em] text-general-red tabular-nums lg:text-[4rem]">
                {proof.value}
              </div>
              <div class="mt-5 max-w-[22ch] text-[13px] font-bold uppercase leading-[1.6] tracking-[0.12em] text-white/50">
                {proof.label}
              </div>
            </div>
          ))}
        </div>
      )
    }

    {/* Positions — three columns, each opening on a ruled numeral. */}
    {
      pillars.length > 0 && (
        <div
          data-reveal-stagger
          class:list={[
            'grid grid-cols-1 gap-x-16 gap-y-14 lg:grid-cols-3 xl:gap-x-20',
            proofs.length > 0 ? 'mt-24 border-t border-white/15 pt-20' : 'mt-20',
          ]}
        >
          {pillars.map((pillar, index) => (
            <article data-reveal="lift" class="group flex flex-col">
              <div class="mb-6 flex items-center gap-4">
                <span class="text-[1.5rem] font-extrabold leading-none tracking-[-0.03em] text-general-red tabular-nums">
                  {pad(index + 1)}
                </span>
                <span
                  class="h-px flex-1 bg-general-red/25 transition-colors duration-500 group-hover:bg-general-red"
                  aria-hidden="true"
                />
              </div>

              <h3 class="text-[1.4rem] font-extrabold leading-[1.2] tracking-[-0.025em] text-white lg:text-[1.55rem]">
                {pillar.title}
              </h3>

              <ReadMore tone="dark" height={190} class="mt-5">
                <p class="text-[15px] leading-[1.85] text-white/60">{pillar.body}</p>
              </ReadMore>
            </article>
          ))}
        </div>
      )
    }

    {
      footnote && (
        <p
          data-reveal="up"
          class="mt-20 max-w-3xl border-l-2 border-general-red/30 pl-8 text-[15px] leading-[1.8] text-white/50"
        >
          {footnote}
        </p>
      )
    }
  </div>
</section>
