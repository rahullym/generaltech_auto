---
import ReadMore from '../ReadMore.astro'
import { splitAccent } from '@/lib/accent'

interface Props {
  eyebrow?: string
  heading?: string
  intro?: string
  proofs?: { id?: string; value: string; label: string }[]
  pillars: { id?: string; title: string; body: string }[]
  footnote?: string
}

const { eyebrow, heading, intro, proofs = [], pillars = [], footnote } = Astro.props
const { lead, accent } = splitAccent(heading)

const pad = (value: number) => String(value).padStart(2, '0')

/**
 * The hairline grids draw their rules from a 1px gap over a lit background, so
 * a half-empty last row would show as a solid light block. Blank cells fill it
 * back in — one set per column count the grid can take.
 */
const fillers = (count: number, columns: number) =>
  Array.from({ length: (columns - (count % columns)) % columns })
---

{/* The one dark band in the middle of the page: the argument for choosing us,
    set as an outlined-numeral column grid so three dense paragraphs read as
    three positions rather than a wall of prose. */}
<section class="relative overflow-hidden border-t border-white/10 bg-general-black px-6 py-24 text-white md:px-12 lg:py-32">
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-[520px] w-[900px] max-w-none -translate-x-1/2 rounded-full opacity-70 blur-[130px]"
    style="background: radial-gradient(circle, rgba(237,28,37,0.28) 0%, rgba(237,28,37,0) 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl">
    {/* Header — heading left, the standing-back line beside it on desktop. */}
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        {
          eyebrow && (
            <div class="mb-6 flex translate-y-4 items-center gap-3 opacity-0 reveal-item">
              <div class="h-[2px] w-8 bg-general-red" />
              <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-general-red">
                {eyebrow}
              </span>
            </div>
          )
        }

        {
          heading && (
            <h2 class="translate-y-8 text-4xl font-black leading-[0.95] tracking-tight opacity-0 reveal-item sm:text-5xl lg:text-[64px]">
              {lead}
              {accent && <span class="font-medium italic text-general-red"> {accent}</span>}
            </h2>
          )
        }
      </div>

      {
        intro && (
          <div class="lg:col-span-5">
            <p class="translate-y-8 border-l-2 border-general-red/30 pl-8 text-lg leading-relaxed text-white/60 opacity-0 reveal-item">
              {intro}
            </p>
          </div>
        )
      }
    </div>

    {/* Number strip — the claims above reduced to figures, hairline-ruled. */}
    {
      proofs.length > 0 && (
        <div class="mt-16 grid grid-cols-2 gap-px bg-white/10 lg:mt-20 lg:grid-cols-4">
          {proofs.map((proof, index) => (
            <div
              class="bg-general-black px-6 py-8 opacity-0 reveal-item lg:px-8 lg:py-10"
              style={`transition-delay: ${index * 70}ms`}
            >
              <div class="text-[40px] font-black leading-none tracking-tighter tabular-nums lg:text-[52px]">
                {proof.value}
              </div>
              <div class="mt-4 text-[12px] font-bold uppercase leading-[1.5] tracking-[0.15em] text-white/40">
                {proof.label}
              </div>
            </div>
          ))}

          {fillers(proofs.length, 2).map(() => (
            <div class="bg-general-black lg:hidden" aria-hidden="true" />
          ))}
          {fillers(proofs.length, 4).map(() => (
            <div class="hidden bg-general-black lg:block" aria-hidden="true" />
          ))}
        </div>
      )
    }

    {/* Pillars — one hairline-separated column each, the approved copy intact. */}
    <div
      class:list={[
        'grid gap-px bg-white/10',
        proofs.length > 0 ? 'mt-px' : 'mt-16 lg:mt-20',
        'lg:grid-cols-3',
      ]}
    >
      {
        pillars.map((pillar, index) => (
          <article
            class="why-pillar group relative flex flex-col bg-general-black px-6 py-10 opacity-0 reveal-item lg:px-8 lg:py-12"
            style={`transition-delay: ${Math.min(index, 6) * 80}ms`}
          >
            {/* Red rule sweeps the head of the column on hover. */}
            <span
              class="absolute left-0 top-0 h-[2px] w-full origin-left scale-x-0 bg-general-red transition-transform duration-700 group-hover:scale-x-100"
              aria-hidden="true"
            />

            <span class="why-index text-[56px] font-black leading-none tracking-tighter tabular-nums lg:text-[64px]" aria-hidden="true">
              {pad(index + 1)}
            </span>

            <h3 class="mt-8 text-2xl font-bold leading-[1.15] tracking-tight lg:text-[28px]">
              {pillar.title}
            </h3>

            <ReadMore tone="dark" height={190} class="mt-5">
              <p class="text-[15px] leading-[1.85] text-white/55 transition-colors duration-500 group-hover:text-white/70">
                {pillar.body}
              </p>
            </ReadMore>

            {/* Foot tick: the columns are unequal by nature — the bodies are the
                approved copy — so each one is given a defined end. */}
            <span
              class="mt-10 block h-px w-10 shrink-0 bg-white/15 transition-colors duration-500 group-hover:bg-general-red"
              aria-hidden="true"
            />
          </article>
        ))
      }

      {fillers(pillars.length, 3).map(() => (
        <div class="hidden bg-general-black lg:block" aria-hidden="true" />
      ))}
    </div>

    {
      footnote && (
        <p class="mt-14 max-w-3xl translate-y-8 border-l-2 border-general-red/30 pl-6 text-[15px] leading-relaxed text-white/45 opacity-0 reveal-item">
          {footnote}
        </p>
      )
    }
  </div>
</section>

<style>
  /* Outlined rather than filled: the index marks the column without competing
     with the title beneath it, and picks up the accent on hover. */
  .why-index {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.22);
    transition:
      -webkit-text-stroke-color 0.5s ease,
      color 0.5s ease;
  }
  .why-pillar:hover .why-index {
    -webkit-text-stroke-color: rgba(237, 28, 37, 0.85);
  }

  /* Safari/Chrome only for the stroke; anywhere else the numeral would vanish,
     so fall back to a faint filled figure. */
  @supports not (-webkit-text-stroke: 1px black) {
    .why-index {
      color: rgba(255, 255, 255, 0.12);
    }
    .why-pillar:hover .why-index {
      color: rgba(237, 28, 37, 0.5);
    }
  }
</style>
