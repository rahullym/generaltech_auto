---
import Picture from '../Picture.astro'
import ReadMore from '../ReadMore.astro'
import RichText from '../RichText.astro'
import { splitAccent } from '@/lib/accent'
import type { Media, RichTextValue } from '@/lib/types'

interface Props {
  layout?: 'default' | 'editorial' | 'split'
  eyebrow?: string
  heading?: string
  numbered?: boolean
  width?: 'prose' | 'full'
  media?: { id?: string; image: Media | string }[]
  mediaPosition?: 'left' | 'right'
  lede?: boolean
  /** Clamp the copy and reveal the rest behind a Read more toggle. */
  collapsible?: boolean
  content: RichTextValue
}

const {
  layout = 'default',
  eyebrow,
  heading,
  numbered = false,
  width = 'prose',
  media = [],
  mediaPosition = 'left',
  lede = false,
  collapsible = false,
  content,
} = Astro.props

const images = media
  .map((entry) => entry.image)
  .filter((image): image is Media => Boolean(image) && typeof image === 'object')

const editorial = layout === 'editorial'
const imageFirst = mediaPosition === 'left'
const { lead, accent } = splitAccent(heading)

const copyClass = [lede && 'prose-lede', numbered && 'prose-beats'].filter(Boolean).join(' ')

// Long passages clamp behind a "Read more" by default; an editor can untick
// the field to publish one open. Payload sends an unset checkbox as null, so
// only an explicit false counts as off.
const clamp = collapsible ?? true
---

{
  layout === 'split' ? (
    <section class="border-t border-gray-100 bg-[#FAFAFA] px-6 md:px-12 py-24 lg:py-32">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 lg:grid-cols-12 xl:gap-24">
        <div class="lg:col-span-5">
          <div class="opacity-0 translate-y-8 reveal-item lg:sticky lg:top-40">
            <div class="mb-8 flex items-center gap-3">
              <div class="h-[2px] w-8 bg-general-red" aria-hidden="true" />
              {eyebrow && (
                <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-gray-500">
                  {eyebrow}
                </span>
              )}
            </div>

            {heading && (
              <h2 class="text-5xl font-black leading-[0.95] tracking-tight text-general-black lg:text-[64px]">
                {lead}
                {accent && (
                  <>
                    {' '}
                    <span class="font-medium italic text-general-red">{accent}</span>
                  </>
                )}
              </h2>
            )}
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="opacity-0 translate-y-8 reveal-item">
            <ReadMore enabled={clamp} tone="light" height={320}>
              <RichText value={content} class={copyClass || undefined} />
            </ReadMore>
          </div>
        </div>
      </div>
    </section>
  ) : editorial ? (
    <section class="bg-white px-6 md:px-12 py-24 lg:py-32">
      <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-12 lg:grid-cols-12 xl:gap-20">
        {/* Imagery — sticky on desktop so the copy scrolls against it. */}
        {images.length > 0 && (
          <div class:list={['lg:col-span-5', imageFirst ? 'lg:order-1' : 'lg:order-2']}>
            <div class="lg:sticky lg:top-40">
              <div class="relative opacity-0 translate-y-8 reveal-item">
                {/* Offset red outline, like a print crop mark behind the photo. */}
                <div
                  class:list={[
                    'pointer-events-none absolute h-full w-full rounded-2xl border-2 border-general-red/30',
                    imageFirst ? '-left-5 -top-5' : '-right-5 -top-5',
                  ]}
                  aria-hidden="true"
                />

                <Picture
                  media={images[0]!}
                  sizes="(min-width: 1024px) 40vw, 100vw"
                  class="w-full rounded-2xl object-cover shadow-[0_30px_80px_rgba(0,0,0,0.14)]"
                />

                {images[1] && (
                  <div
                    class:list={[
                      'absolute w-1/2 overflow-hidden rounded-2xl border-4 border-white shadow-[0_20px_50px_rgba(0,0,0,0.18)]',
                      '-bottom-8 lg:-bottom-10',
                      imageFirst ? '-right-4 lg:-right-8' : '-left-4 lg:-left-8',
                    ]}
                  >
                    <Picture
                      media={images[1]}
                      sizes="(min-width: 1024px) 20vw, 50vw"
                      class="aspect-[3/2] w-full object-cover"
                    />
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* Copy */}
        <div
          class:list={[
            images.length > 0 ? 'lg:col-span-7' : 'lg:col-span-12',
            imageFirst ? 'lg:order-2' : 'lg:order-1',
            images[1] && 'mt-14 lg:mt-0',
          ]}
        >
          <div class="opacity-0 translate-y-8 reveal-item">
            <div class="mb-8 h-[2px] w-16 bg-general-red" aria-hidden="true" />

            <ReadMore enabled={clamp}>
              <RichText value={content} class={copyClass || undefined} />
            </ReadMore>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="bg-white px-6 md:px-12 py-16 lg:py-20">
      <div
        class:list={[
          'mx-auto opacity-0 translate-y-8 reveal-item',
          width === 'prose' ? 'max-w-3xl' : 'max-w-7xl',
        ]}
      >
        <ReadMore enabled={clamp}>
          <RichText value={content} class={copyClass || undefined} />
        </ReadMore>
      </div>
    </section>
  )
}

