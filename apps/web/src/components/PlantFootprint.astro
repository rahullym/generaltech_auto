---
/**
 * What the work does to the plant, drawn beside the opening paragraph of an
 * application page.
 *
 * The "How it works" diagram further down answers how a reading travels. This
 * one answers the question a plant manager asks first: what are you going to
 * put on my equipment, and what are you going to leave alone? Each row starts
 * from something already on site, in grey, and ends at what is fitted to it, in
 * red, with the connector saying how the two meet. A row with nothing fitted is
 * left in on purpose, because "untouched" is as much of an answer as "added".
 *
 * One list, so a screen reader hears each row as a sentence; the connectors are
 * decorative.
 *
 * Where the figure is narrow the three columns leave each label about forty
 * pixels, so a row stacks instead: what is there, the connector running down,
 * what is fitted. That follows the figure's own width, not the screen's — it is
 * narrower in the two-column layout on a small laptop than on a large phone.
 */
import { icon } from '@/lib/diagram-icons'

export interface FootprintRow {
  id?: string
  have: string
  haveIcon?: string
  add?: string | null
  addIcon?: string | null
  how: string
}

interface Props {
  label: string
  rows: FootprintRow[]
}

const { label, rows } = Astro.props
---

<figure class="@container rounded-[28px] border border-gray-200/70 bg-gray-50/70 p-5 sm:p-7">
  <figcaption class="mb-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-general-black">{label}</span>
    <span class="flex items-center gap-4 text-[12px] font-medium text-general-black" aria-hidden="true">
      <span class="flex items-center gap-1.5">
        <span class="h-2.5 w-2.5 rounded-sm border border-gray-400 bg-white" />
        Already there
      </span>
      <span class="flex items-center gap-1.5">
        <span class="h-2.5 w-2.5 rounded-sm bg-general-red" />
        What we fit
      </span>
    </span>
  </figcaption>

  <ul class="flex flex-col gap-5 @md:gap-3">
    {
      rows.map((row) => (
        <li class="grid grid-cols-1 items-center @md:grid-cols-[minmax(0,1fr)_6rem_minmax(0,1fr)]">
          <span class="flex min-h-14 items-center gap-2.5 rounded-xl border border-gray-200 bg-white px-3 py-2.5 text-[13px] font-semibold leading-snug text-general-black">
            <svg
              class="h-5 w-5 shrink-0 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icon(row.haveIcon)}
            />
            {row.have}
          </span>

          {/* The connector: a line with how the two meet written over it,
              or beside it where the row is stacked and the line runs down from
              under the icon. Dashed and grey when nothing is fitted. */}
          <span class="relative flex items-center gap-3 py-1.5 pl-[21px] @md:h-full @md:flex-col @md:justify-center @md:gap-0 @md:px-1.5 @md:py-0">
            <span
              class="order-2 text-[11.5px] font-semibold leading-tight text-general-black [text-wrap:balance] @md:order-none @md:mb-1 @md:text-center @md:text-[10.5px]"
            >
              <span class="sr-only">: </span>
              {row.how}
            </span>
            <span
              class:list={[
                'relative block h-5 w-0 shrink-0 border-l-2 @md:h-0 @md:w-full @md:border-l-0 @md:border-t-2',
                row.add ? 'border-general-red' : 'border-dashed border-gray-300',
              ]}
              aria-hidden="true"
            >
              {row.add && (
                <svg
                  class="absolute -bottom-1 left-1/2 h-3 w-3 -translate-x-1/2 rotate-90 text-general-red @md:-right-1 @md:bottom-auto @md:left-auto @md:top-1/2 @md:-mt-px @md:translate-x-0 @md:-translate-y-1/2 @md:rotate-0"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m4 2 4 4-4 4" />
                </svg>
              )}
            </span>
          </span>

          {row.add ? (
            <span class="flex min-h-14 items-center gap-2.5 rounded-xl bg-general-red px-3 py-2.5 text-[13px] font-semibold leading-snug text-white shadow-[0_10px_24px_-14px_rgba(237,28,37,0.8)]">
              <svg
                class="h-5 w-5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icon(row.addIcon ?? undefined)}
              />
              <span class="sr-only">, </span>
              {row.add}
            </span>
          ) : (
            <span class="flex min-h-14 items-center rounded-xl border border-dashed border-gray-300 px-3 py-2.5 text-[13px] font-medium leading-snug text-general-black">
              <span class="sr-only">, </span>
              Nothing fitted
            </span>
          )}
        </li>
      ))
    }
  </ul>
</figure>
