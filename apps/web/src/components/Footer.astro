---
import Picture from './Picture.astro'
import { resolveHref } from '@/lib/urls'
import type { Footer, SiteSettings } from '@/lib/types'

interface Props {
  footer: Footer
  settings: SiteSettings
}

const { footer, settings } = Astro.props
const year = new Date().getFullYear()
const columns = footer.columns ?? []
const socials = footer.socials ?? []

// The footer sits on black, so prefer the light logo; only fall back to
// inverting the main mark when no light version has been uploaded.
const footerLogo = settings.logoInverse ?? settings.logo
const invertLogo = !settings.logoInverse

const phone = settings.contact?.phone
const email = settings.contact?.email
const address = settings.contact?.address

/** Inline brand marks, keyed by the platform string stored in the CMS. */
const socialIcons: Record<string, { path: string; color: string }> = {
  linkedin: {
    path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
    color: '#0A66C2',
  },
  facebook: {
    path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
    color: '#1877F2',
  },
  x: { path: 'M4 4l16 16M20 4L4 20', color: '#000000' },
  twitter: { path: 'M4 4l16 16M20 4L4 20', color: '#000000' },
  youtube: {
    path: 'M22.5 7.2a2.8 2.8 0 0 0-2-2C18.8 4.8 12 4.8 12 4.8s-6.8 0-8.5.4a2.8 2.8 0 0 0-2 2A29 29 0 0 0 1.1 12a29 29 0 0 0 .4 4.8 2.8 2.8 0 0 0 2 2c1.7.4 8.5.4 8.5.4s6.8 0 8.5-.4a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .4-4.8 29 29 0 0 0-.4-4.8z M9.8 15.3V8.7l5.7 3.3z',
    color: '#FF0000',
  },
  github: {
    path: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-1-2.6c3.1-.3 6.4-1.5 6.4-7A5.4 5.4 0 0 0 20 4.8a5 5 0 0 0-.1-3.7s-1.2-.4-4 1.4a13.4 13.4 0 0 0-7 0C6.1.7 4.9 1.1 4.9 1.1a5 5 0 0 0-.1 3.7 5.4 5.4 0 0 0-1.4 3.7c0 5.5 3.3 6.7 6.4 7a3.4 3.4 0 0 0-1 2.6V22',
    color: '#181717',
  },
}
---

<footer class="bg-general-black text-white py-24 px-6 md:px-12">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 lg:gap-20">
    {/* Company info */}
    <div class="flex flex-col">
      <div class="mb-10">
        {
          footerLogo && typeof footerLogo === 'object' ? (
            <Picture
              media={footerLogo}
              raw
              class:list={['h-16 w-auto', invertLogo && 'brightness-0 invert']}
            />
          ) : (
            <span class="text-2xl font-black tracking-tight text-white">{settings.siteName}</span>
          )
        }
      </div>

      <div class="text-gray-400 text-[14px] font-light leading-loose mb-12 space-y-1">
        <p class="text-white font-medium mb-3 tracking-wide">{settings.siteName}</p>
        {settings.tagline && <p>{settings.tagline}</p>}
        {address && <p class="whitespace-pre-line">{address}</p>}
        {phone && (
          <p class="pt-3">
            Tel:
            <a href={`tel:${phone.replace(/\s+/g, '')}`} class="hover:text-general-red transition-colors">
              {' '}{phone}
            </a>
          </p>
        )}
        {email && (
          <p>
            <a href={`mailto:${email}`} class="hover:text-general-red transition-colors">Email Us</a>
          </p>
        )}
      </div>

      {
        socials.length > 0 && (
          <div class="flex gap-4 mt-auto">
            {socials.map((social) => {
              const icon = socialIcons[social.platform?.toLowerCase()]
              return (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.platform}
                  class="social-pill w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-gray-400 transition-colors"
                  style={icon ? `--brand:${icon.color}` : undefined}
                >
                  {icon ? (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={icon.path} />
                    </svg>
                  ) : (
                    <span class="text-[11px] font-bold uppercase">{social.platform?.slice(0, 2)}</span>
                  )}
                </a>
              )
            })}
          </div>
        )
      }
    </div>

    {/* Link pillars */}
    {
      columns.map((column) => (
        <div>
          <h2 class="text-xs font-bold tracking-[0.2em] uppercase text-white mb-10 border-b border-white/10 pb-4">
            {column.title}
          </h2>
          <ul class="flex flex-col gap-4 text-[14px] font-light text-gray-400">
            {(column.links ?? []).map((entry) => (
              <li>
                <a
                  href={resolveHref(entry.link)}
                  class="hover:text-general-red transition-colors"
                  {...entry.link?.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                >
                  {entry.link?.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  {/* Footer bottom */}
  <div
    class="max-w-7xl mx-auto mt-28 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between text-[13px] text-gray-500 font-light tracking-wide gap-8"
  >
    <p>{footer.copyright ?? `© ${year} ${settings.siteName}. All rights reserved.`}</p>
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-3">
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <a href="/docs" class="hover:text-white transition-colors">Docs</a>
      <a href="/rss.xml" class="hover:text-white transition-colors">RSS</a>
    </div>
  </div>
</footer>

<style>
  /* Each platform passes its own brand colour in as --brand; the pill fills
     with it on hover, matching the generaltech footer. */
  .social-pill:hover {
    color: #fff;
    background: var(--brand, #ed1c25);
    border-color: var(--brand, #ed1c25);
  }
</style>
