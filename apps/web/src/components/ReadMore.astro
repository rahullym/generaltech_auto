---
/**
 * Clamps a long passage to a few lines and reveals the rest on demand.
 *
 * The clamp is applied by script rather than in CSS so that without
 * JavaScript — and for anything reading the page rather than looking at it —
 * the whole passage is present and open. A passage already short enough is
 * left alone and never grows a toggle, so this can be wrapped around copy of
 * unknown length without guessing.
 */
interface Props {
  /** Collapsed height in pixels. */
  height?: number
  /** The background the fade resolves into. */
  tone?: 'white' | 'light' | 'dark'
  /** Set false to render the copy untouched — no clamp, no toggle. */
  enabled?: boolean
  class?: string
}

const { height = 260, tone = 'white', enabled = true, class: className } = Astro.props

const id = `read-more-${Math.random().toString(36).slice(2, 9)}`
const dark = tone === 'dark'
---

{
  enabled ? (
    <div
      class:list={['copy-collapse', `copy-collapse--${tone}`, className]}
      data-collapsible
      data-collapse-height={height}
    >
      <div class="copy-collapse-body" id={id} data-collapse-body>
        <slot />
      </div>

      <button
        type="button"
        class:list={[
          'mt-8 inline-flex items-center gap-2 text-[12px] font-bold uppercase tracking-[0.15em] text-general-red transition-colors',
          dark ? 'hover:text-white' : 'hover:text-general-black',
        ]}
        data-collapse-toggle
        aria-expanded="false"
        aria-controls={id}
        hidden
      >
        <span data-collapse-label>Read more</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300"
          data-collapse-chevron
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
    </div>
  ) : (
    <div class={className}>
      <slot />
    </div>
  )
}

<script>
  // One initialiser for every clamped passage on the page. Astro hoists this
  // once however many times the component is used.
  function initReadMore() {
    document.querySelectorAll<HTMLElement>('.copy-collapse[data-collapsible]').forEach((root) => {
      // Guard: this runs on both DOMContentLoaded and astro:page-load.
      if (root.dataset.collapseReady) return
      root.dataset.collapseReady = 'true'

      const body = root.querySelector<HTMLElement>('[data-collapse-body]')
      const toggle = root.querySelector<HTMLButtonElement>('[data-collapse-toggle]')
      const label = root.querySelector<HTMLElement>('[data-collapse-label]')
      const chevron = root.querySelector<HTMLElement>('[data-collapse-chevron]')
      if (!body || !toggle) return

      const collapsedHeight = Number(root.dataset.collapseHeight) || 260

      // Already short enough — leave it open and keep the toggle hidden. The
      // margin is generous on purpose: a toggle that reveals two or three more
      // lines costs the reader more than it saves.
      if (body.scrollHeight <= collapsedHeight + 120) return

      body.style.overflow = 'hidden'
      body.style.transition = 'max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1)'
      body.style.maxHeight = `${collapsedHeight}px`
      root.classList.add('is-collapsed')
      toggle.hidden = false

      toggle.addEventListener('click', () => {
        const collapsed = root.classList.contains('is-collapsed')

        if (collapsed) {
          body.style.maxHeight = `${body.scrollHeight}px`
        } else {
          // Coming back from `none`, give the transition a starting value.
          body.style.maxHeight = `${body.scrollHeight}px`
          void body.offsetHeight
          body.style.maxHeight = `${collapsedHeight}px`
        }

        root.classList.toggle('is-collapsed', !collapsed)
        toggle.setAttribute('aria-expanded', String(collapsed))
        if (label) label.textContent = collapsed ? 'Read less' : 'Read more'
        chevron?.classList.toggle('rotate-180', collapsed)

        // Once open, drop the cap so later reflows (fonts, images) are not clipped.
        if (collapsed) {
          window.setTimeout(() => {
            if (!root.classList.contains('is-collapsed')) body.style.maxHeight = 'none'
          }, 550)
        }
      })
    })
  }

  document.addEventListener('astro:page-load', initReadMore)
  document.addEventListener('DOMContentLoaded', initReadMore)
</script>
