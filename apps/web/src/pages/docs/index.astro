---
import PageHero from '@/components/PageHero.astro'
import Base from '@/layouts/Base.astro'
import { listDocs } from '@/lib/payload'
import { isPreview } from '@/lib/preview'
import { buildDocsTree } from '@/lib/urls'

export const prerender = false

const draft = isPreview(Astro.cookies)
const docs = await listDocs({ draft })
const tree = buildDocsTree(docs.docs)
---

<Base title="Documentation" description="Guides, references and how-tos." heroFirst>
  <PageHero
    eyebrow="Knowledge Base"
    title="Documentation"
    accent="& guides."
    description="Guides, references and how-tos."
  />

  <section class="bg-white px-6 md:px-12 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl">
      {
        tree.length === 0 ? (
          <p class="py-24 text-center text-xl font-light text-gray-500">
            No documentation published yet.
          </p>
        ) : (
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {tree.map((section, index) => (
              <div
                class="group flex flex-col rounded-2xl border border-gray-100 bg-white p-10 opacity-0 translate-y-8 reveal-item transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl"
                style={`transition-delay: ${index * 50}ms`}
              >
                <span class="mb-6 text-[11px] font-bold uppercase tracking-[0.4em] text-gray-400 transition-colors group-hover:text-general-red">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="mb-6 h-[2px] w-12 origin-left bg-general-red transition-all duration-700 group-hover:w-full" />

                <h2 class="mb-3 text-2xl font-bold leading-[1.1] tracking-tight text-general-black lg:text-[26px]">
                  <a href={`/docs/${section.slug}`} class="hover:text-general-red transition-colors">
                    {section.title}
                  </a>
                </h2>

                {section.description && (
                  <p class="text-[15px] leading-relaxed text-gray-700">{section.description}</p>
                )}

                {section.children.length > 0 && (
                  <ul class="mt-8 flex flex-col gap-3 border-t border-gray-100 pt-6">
                    {section.children.map((child) => (
                      <li>
                        <a
                          href={`/docs/${child.slug}`}
                          class="inline-flex items-center gap-2 text-[14px] font-light text-gray-600 transition-colors hover:text-general-red"
                        >
                          <span class="h-[1px] w-3 bg-general-red" aria-hidden="true" />
                          {child.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>
