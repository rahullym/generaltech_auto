---
import PageHero from '@/components/PageHero.astro'
import Base from '@/layouts/Base.astro'

export const prerender = false
---

<Base title="Page not found" noindex heroFirst>
  <PageHero
    eyebrow="Error 404"
    title="We couldn't find"
    accent="that page."
    description="The page you're looking for may have been moved, renamed or removed."
  >
    <div class="hero-reveal opacity-0 translate-y-8 transition-all duration-1000 delay-700 mt-12">
      <a
        href="/"
        class="inline-flex items-center justify-center gap-3 rounded-xl bg-general-red px-8 py-5 text-[13px] font-bold uppercase tracking-[0.1em] text-white shadow-lg shadow-general-red/20 transition-all duration-500 hover:bg-white hover:text-general-black group"
      >
        Back to home
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
    </div>
  </PageHero>
</Base>
