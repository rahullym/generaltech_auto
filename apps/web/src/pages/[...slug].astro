---
import BlockRenderer from '@/components/BlockRenderer.astro'
import Base from '@/layouts/Base.astro'
import { getPage } from '@/lib/payload'
import { isPreview } from '@/lib/preview'
import { getServicePage, serviceRedirect } from '@/lib/service-pages'
import { serviceSchema } from '@/lib/service-schema'

export const prerender = false

const { slug } = Astro.params
const draft = isPreview(Astro.cookies)

// `home` is served at `/`; refuse to also serve it at `/home`.
if (!slug || slug === 'home') {
  return Astro.redirect('/', 301)
}

/**
 * One legacy service path carries commas, brackets and an ampersand, and a
 * client is free to send those percent-encoded or raw. Decoding first means
 * both spellings resolve to the same document; a malformed escape is left as
 * written rather than throwing.
 */
const decode = (value: string): string => {
  try {
    return decodeURIComponent(value)
  } catch {
    return value
  }
}

// Trailing slashes are cosmetic; `/a/b/` and `/a/b` are the same document.
const path = decode(slug).replace(/\/+$/, '')

// A service page that moved to the permalink its source document specifies
// still answers on its old path, permanently.
const moved = serviceRedirect(path)
if (moved) {
  return Astro.redirect(moved, 301)
}

// The CMS is authoritative. The service inner pages ship with the build and
// answer only for slugs the CMS does not already hold, so moving one into
// Payload later takes precedence without a code change.
const cmsPage = await getPage(path, { draft })
const service = cmsPage ? null : getServicePage(path)
const page = cmsPage ?? service

if (!page) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

// The nav is fixed; a page that opens with a dark hero paints underneath it and
// pads itself, so only the other layouts need a spacer.
const first = page.layout?.[0]
const heroFirst = first?.blockType === 'hero' && first?.variant !== 'split'
---

<Base
  title={page.meta?.title ?? page.title}
  exactTitle={Boolean(page.meta?.title)}
  description={page.meta?.description}
  image={page.meta?.image}
  isDraft={draft && page._status === 'draft'}
  heroFirst={heroFirst}
>
  {
    service && (
      <script
        is:inline
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(serviceSchema(service))}
      />
    )
  }

  {/* A service page publishes FAQPage inside its own graph above. */}
  <BlockRenderer blocks={page.layout} faqSchema={!service} />
</Base>
