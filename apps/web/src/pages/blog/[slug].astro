---
import PageHero from '@/components/PageHero.astro'
import Picture from '@/components/Picture.astro'
import RichText from '@/components/RichText.astro'
import Base from '@/layouts/Base.astro'
import { lexicalToText } from '@/lib/lexical'
import { getPost, listPosts } from '@/lib/payload'
import { isPreview } from '@/lib/preview'
import { formatDate, readingTime } from '@/lib/urls'
import type { Author, Category } from '@/lib/types'

export const prerender = false

const { slug } = Astro.params
const draft = isPreview(Astro.cookies)

if (!slug) return new Response(null, { status: 404 })

const post = await getPost(slug, { draft })

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const plainText = lexicalToText(post.content)
const minutes = readingTime(plainText)

const authors = (post.authors ?? []).filter(
  (author): author is Author => typeof author === 'object',
)
const categories = (post.categories ?? []).filter(
  (category): category is Category => typeof category === 'object',
)

// Same-category posts, minus this one.
const related = await listPosts({
  limit: 3,
  where: {
    and: [
      { id: { not_equals: post.id } },
      ...(categories.length ? [{ 'categories.slug': { in: categories.map((c) => c.slug).join(',') } }] : []),
    ],
  },
})

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  description: post.excerpt ?? plainText.slice(0, 200),
  author: authors.map((a) => ({ '@type': 'Person', name: a.name })),
}
---

<Base
  title={post.meta?.title ?? post.title}
  description={post.meta?.description ?? post.excerpt}
  image={post.meta?.image ?? post.heroImage}
  type="article"
  publishedAt={post.publishedAt}
  isDraft={draft && post._status === 'draft'}
  heroFirst
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <PageHero
    eyebrow={categories[0]?.title ?? 'Article'}
    title={post.title}
    description={post.excerpt}
    image={post.heroImage}
  >
    <div
      class="hero-reveal mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[11px] font-bold uppercase tracking-[0.25em] text-white/50 opacity-0 translate-y-8 transition-all duration-1000 delay-700"
    >
      <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
      <span class="h-[1px] w-4 bg-general-red" aria-hidden="true"></span>
      <span>{minutes} min read</span>
      {
        authors.length > 0 && (
          <>
            <span class="h-[1px] w-4 bg-general-red" aria-hidden="true" />
            <span>By {authors.map((a) => a.name).join(', ')}</span>
          </>
        )
      }
    </div>
  </PageHero>

  <article class="bg-white px-6 md:px-12 py-24 lg:py-32">
    <div class="mx-auto max-w-3xl">
      {
        categories.length > 0 && (
          <div class="mb-12 flex flex-wrap gap-3 border-b border-gray-100 pb-10">
            {categories.map((category) => (
              <a
                href={`/blog?category=${category.slug}`}
                class="rounded-xl border border-gray-200 px-5 py-2.5 text-[12px] font-bold uppercase tracking-[0.1em] text-gray-600 transition-all duration-300 hover:border-general-red hover:text-general-red"
              >
                {category.title}
              </a>
            ))}
          </div>
        )
      }

      <RichText value={post.content} />

      {
        (post.tags ?? []).length > 0 && (
          <ul class="mt-16 flex flex-wrap gap-3 border-t border-gray-100 pt-10">
            {(post.tags ?? []).map((entry) => (
              <li class="text-[11px] font-bold uppercase tracking-[0.25em] text-gray-400">
                #{entry.tag}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </article>

  {
    related.docs.length > 0 && (
      <section class="border-t border-gray-100 bg-white px-6 md:px-12 pb-32 pt-20">
        <div class="mx-auto max-w-7xl">
          <div class="mb-16 flex flex-col items-center text-center opacity-0 translate-y-8 reveal-item">
            <div class="mb-8 flex items-center gap-3">
              <div class="h-[2px] w-8 bg-general-red" />
              <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-general-red">
                More reading
              </span>
              <div class="h-[2px] w-8 bg-general-red" />
            </div>
            <h2 class="text-4xl font-black leading-[0.95] tracking-tight text-general-black lg:text-[56px]">
              Keep <span class="text-general-red italic font-medium">reading.</span>
            </h2>
          </div>

          <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
            {related.docs.map((item, index) => (
              <a
                href={`/blog/${item.slug}`}
                class="group relative flex h-[360px] flex-col justify-end overflow-hidden rounded-2xl border border-gray-100 bg-general-black p-8 opacity-0 translate-y-8 reveal-item transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl"
                style={`transition-delay: ${index * 50}ms`}
              >
                <div class="absolute inset-0 z-0">
                  {item.heroImage && (
                    <Picture
                      media={item.heroImage}
                      sizes="(min-width: 768px) 33vw, 100vw"
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-70 transition-opacity duration-500 group-hover:opacity-85" />
                </div>
                <div class="relative z-10">
                  <time
                    datetime={item.publishedAt}
                    class="text-[10px] font-bold uppercase tracking-[0.4em] text-white/60"
                  >
                    {formatDate(item.publishedAt)}
                  </time>
                  <div class="mt-4 mb-5 h-[2px] w-12 origin-left bg-general-red transition-all duration-700 group-hover:w-full" />
                  <h3 class="text-xl font-bold leading-[1.15] tracking-tight text-white">{item.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
