---
/**
 * Throwaway comparison route. Renders the REAL home page — every section,
 * every word — through one markup pass themed three ways, so the directions
 * can be compared on actual content rather than samples. Nothing is trimmed:
 * the renderer below has a branch for every block type on the page.
 *
 * Switch with ?dir=a|b|c. Delete this file once a direction is chosen.
 */
import Picture from '@/components/Picture.astro'
import { lexicalToHtml } from '@/lib/lexical'
import { getPage } from '@/lib/payload'
import { resolveHref } from '@/lib/urls'
import { splitAccent } from '@/lib/accent'
import type { Block } from '@/lib/types'

export const prerender = false

const dir = (Astro.url.searchParams.get('dir') ?? 'a').toLowerCase()
const page = await getPage('home')
if (!page) return new Response('home page not found', { status: 404 })

const layout = (page.layout ?? []) as Block[]

const names: Record<string, string> = {
  a: 'A — Soft Modern',
  b: 'B — Editorial',
  c: 'C — Dark Technical',
}
---

<html lang="en" data-dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{names[dir] ?? names.a} — full page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600&family=Inter+Tight:wght@400..800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
      img { max-width:100%; display:block; }

      /* ---- A: soft modern ---- */
      [data-dir='a'] {
        --bg:#FAFAFA; --panel:#fff; --fg:#17171A; --muted:#63636E;
        --accent:#ED1C25; --accent-2:#FF7A45; --border:#EDEDF0;
        --radius:24px; --display:'Manrope',sans-serif; --body:'Manrope',sans-serif;
        --display-weight:700; --display-tracking:-.035em; --lead:1.02;
        --label-transform:uppercase; --label-spacing:.18em;
      }
      /* ---- B: editorial ---- */
      [data-dir='b'] {
        --bg:#F7F5F1; --panel:#FFFDF9; --fg:#1A1815; --muted:#5A544C;
        --accent:#B4141B; --accent-2:#B4141B; --border:#DCD6CC;
        --radius:4px; --display:'Instrument Serif',Georgia,serif; --body:'Manrope',sans-serif;
        --display-weight:400; --display-tracking:-.02em; --lead:.98;
        --label-transform:uppercase; --label-spacing:.2em;
      }
      /* ---- C: dark technical ---- */
      [data-dir='c'] {
        --bg:#0A0A0C; --panel:#141418; --fg:#EDEDF2; --muted:#8E8E9A;
        --accent:#FF3B43; --accent-2:#FF5A45; --border:#212127;
        --radius:20px; --display:'Inter Tight',sans-serif; --body:'Inter Tight',sans-serif;
        --display-weight:700; --display-tracking:-.04em; --lead:1;
        --label-transform:uppercase; --label-spacing:.14em;
      }

      body { background:var(--bg); color:var(--fg); font-family:var(--body); -webkit-font-smoothing:antialiased; }
      .wrap { max-width:1180px; margin:0 auto; padding:0 28px; }

      .switch {
        position:sticky; top:0; z-index:200; display:flex; gap:8px; align-items:center;
        padding:12px 28px; background:#101012; border-bottom:1px solid #232327; overflow-x:auto;
      }
      .switch a {
        color:#b6b6bd; text-decoration:none; font-size:13px; font-weight:600;
        padding:7px 15px; border-radius:999px; white-space:nowrap; border:1px solid #2c2c31;
      }
      .switch a.on { background:#fff; color:#101012; border-color:#fff; }
      .switch span { color:#6a6a74; font-size:12px; margin-left:auto; white-space:nowrap; }

      section { padding:96px 0; }
      .label {
        display:inline-flex; align-items:center; gap:10px; font-size:11px; font-weight:700;
        letter-spacing:var(--label-spacing); text-transform:var(--label-transform);
        color:var(--accent); margin-bottom:18px;
      }
      .label::before { content:''; width:26px; height:2px; background:var(--accent); }
      [data-dir='b'] .label { font-family:'JetBrains Mono',monospace; font-weight:400; }
      [data-dir='c'] .label { font-family:'JetBrains Mono',monospace; }

      h2.display {
        font-family:var(--display); font-weight:var(--display-weight);
        letter-spacing:var(--display-tracking); line-height:var(--lead);
        font-size:clamp(36px,5vw,64px); max-width:18ch;
      }
      [data-dir='b'] h2.display { font-size:clamp(42px,6vw,78px); max-width:16ch; }
      h2.display em { font-style:normal; color:var(--accent); }
      [data-dir='a'] h2.display em {
        background:linear-gradient(100deg,var(--accent),var(--accent-2));
        -webkit-background-clip:text; background-clip:text; color:transparent;
      }
      [data-dir='b'] h2.display em { font-style:italic; }
      [data-dir='c'] h2.display {
        background:linear-gradient(180deg,#fff 45%,#8A8A96);
        -webkit-background-clip:text; background-clip:text; color:transparent;
      }
      [data-dir='c'] h2.display em {
        background:linear-gradient(100deg,var(--accent),var(--accent-2));
        -webkit-background-clip:text; background-clip:text; color:transparent;
      }
      p.intro { margin-top:20px; font-size:18px; line-height:1.7; color:var(--muted); max-width:56ch; }

      /* rich text */
      .rt { font-size:17px; line-height:1.8; color:var(--muted); max-width:72ch; }
      .rt > * + * { margin-top:1.15em; }
      .rt h2,.rt h3 { color:var(--fg); font-family:var(--display); font-weight:var(--display-weight); line-height:1.15; letter-spacing:var(--display-tracking); }
      .rt h2 { font-size:clamp(28px,3.4vw,42px); }
      .rt h3 { font-size:22px; }
      .rt strong { color:var(--fg); }
      .rt a { color:var(--accent); }
      .rt ul,.rt ol { padding-left:1.3em; }
      .rt li::marker { color:var(--accent); }
      .rt img { border-radius:var(--radius); }

      /* cards */
      .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); gap:18px; margin-top:52px; }
      .card { background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); padding:30px; transition:transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s, border-color .35s; }
      [data-dir='a'] .card { box-shadow:0 1px 2px rgba(16,16,20,.04),0 12px 30px rgba(16,16,20,.05); }
      [data-dir='a'] .card:hover { transform:translateY(-6px); box-shadow:0 20px 48px rgba(16,16,20,.10); }
      [data-dir='b'] .card { background:transparent; border:0; border-top:1px solid var(--border); border-radius:0; padding:26px 0; }
      [data-dir='c'] .card { background:linear-gradient(160deg,#151519,#0D0D10); }
      [data-dir='c'] .card:hover { border-color:#3A3A44; transform:translateY(-4px); }
      .card .n { font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--accent); letter-spacing:.1em; }
      .card h3 { margin:14px 0 9px; font-size:19px; font-weight:700; letter-spacing:-.02em; color:var(--fg); font-family:var(--display); }
      [data-dir='b'] .card h3 { font-size:25px; font-weight:400; }
      .card p { font-size:15px; line-height:1.72; color:var(--muted); }

      /* steps */
      .steps { margin-top:52px; }
      .step { display:grid; grid-template-columns:auto 1fr; gap:26px; padding:26px 0; border-bottom:1px solid var(--border); }
      .step .n { font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--accent); padding-top:4px; letter-spacing:.08em; }
      .step h3 { font-size:21px; font-weight:700; margin-bottom:7px; color:var(--fg); font-family:var(--display); letter-spacing:-.02em; }
      [data-dir='b'] .step h3 { font-weight:400; font-size:26px; }
      .step p { font-size:15.5px; line-height:1.75; color:var(--muted); max-width:70ch; }
      .step .meta { font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--accent); letter-spacing:.12em; text-transform:uppercase; display:block; margin-bottom:6px; }

      /* logos */
      .logos { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:1px; background:var(--border); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; margin-top:48px; }
      .logos > * { background:var(--panel); aspect-ratio:3/2; display:grid; place-items:center; padding:18px; }
      .logos img { max-height:42px; width:auto; object-fit:contain; filter:grayscale(1); opacity:.6; transition:.35s; }
      [data-dir='c'] .logos img { filter:grayscale(1) invert(1); opacity:.55; }
      .logos > *:hover img { filter:none; opacity:1; }
      [data-dir='c'] .logos > *:hover img { filter:invert(1); opacity:1; }

      /* faq */
      .faq { margin-top:48px; border-top:1px solid var(--border); }
      .faq details { border-bottom:1px solid var(--border); }
      .faq summary { list-style:none; cursor:pointer; display:flex; justify-content:space-between; gap:20px; padding:22px 0; font-size:18px; font-weight:600; color:var(--fg); font-family:var(--display); letter-spacing:-.01em; }
      [data-dir='b'] .faq summary { font-weight:400; font-size:23px; }
      .faq summary::-webkit-details-marker { display:none; }
      .faq summary::after { content:'+'; color:var(--accent); font-family:'JetBrains Mono',monospace; font-size:20px; line-height:1; }
      .faq details[open] summary::after { content:'−'; }
      .faq .rt { padding-bottom:24px; font-size:16px; }

      /* cta */
      .cta { margin-top:20px; border-radius:var(--radius); padding:54px 44px; }
      [data-dir='a'] .cta { background:linear-gradient(120deg,#17171A,#2A1416 55%,#4A1216); color:#fff; }
      [data-dir='b'] .cta { background:transparent; border-top:1px solid var(--border); border-radius:0; padding:54px 0 0; text-align:center; }
      [data-dir='c'] .cta { border:1px solid rgba(255,59,67,.25); background:radial-gradient(ellipse at 50% 0%,rgba(255,59,67,.15),transparent 70%),#0E0E11; text-align:center; }
      .cta h3 { font-family:var(--display); font-weight:var(--display-weight); font-size:clamp(26px,3.4vw,42px); line-height:1.08; letter-spacing:var(--display-tracking); }
      [data-dir='a'] .cta h3 em { font-style:normal; background:linear-gradient(100deg,var(--accent),var(--accent-2)); -webkit-background-clip:text; background-clip:text; color:transparent; }
      [data-dir='b'] .cta h3 em { font-style:italic; color:var(--accent); }
      [data-dir='c'] .cta h3 em { font-style:normal; color:var(--accent); }
      .cta p { margin-top:16px; font-size:17px; line-height:1.7; opacity:.75; max-width:60ch; }
      [data-dir='b'] .cta p, [data-dir='c'] .cta p { margin-left:auto; margin-right:auto; }
      .btn { margin-top:26px; display:inline-block; text-decoration:none; font-weight:700; font-size:15px; padding:15px 30px; border-radius:999px; }
      [data-dir='a'] .btn { background:#fff; color:#17171A; }
      [data-dir='b'] .btn { background:transparent; color:var(--fg); border-bottom:1px solid var(--fg); border-radius:0; padding:0 0 6px; font-weight:500; }
      [data-dir='c'] .btn { background:linear-gradient(120deg,var(--accent),var(--accent-2)); color:#fff; border-radius:12px; box-shadow:0 10px 32px rgba(255,59,67,.3); }
      .btns { display:flex; flex-wrap:wrap; gap:14px; align-items:center; }
      [data-dir='b'] .btns,[data-dir='c'] .btns { justify-content:center; }

      /* hero */
      .hero { position:relative; padding:120px 0 96px; overflow:hidden; }
      [data-dir='c'] .hero::before {
        content:''; position:absolute; inset:0;
        background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);
        background-size:64px 64px;
        mask-image:radial-gradient(ellipse 80% 55% at 50% 0%,#000 40%,transparent 100%);
      }
      .hero .inner { position:relative; }
      .hero h1 {
        font-family:var(--display); font-weight:var(--display-weight);
        font-size:clamp(42px,6.4vw,84px); line-height:var(--lead); letter-spacing:var(--display-tracking); max-width:17ch;
      }
      [data-dir='b'] h1 em { font-style:italic; color:var(--accent); }
      [data-dir='a'] h1 em,[data-dir='c'] h1 em { font-style:normal; background:linear-gradient(100deg,var(--accent),var(--accent-2)); -webkit-background-clip:text; background-clip:text; color:transparent; }
      .hero-imgs { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:14px; margin-top:48px; }
      .hero-imgs img { border-radius:var(--radius); aspect-ratio:4/3; object-fit:cover; width:100%; }
      .marquee { margin-top:52px; overflow:hidden; border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:20px 0; }
      .marquee .track { display:flex; width:max-content; animation:scroll 70s linear infinite; }
      .marquee img { height:34px; width:auto; margin:0 30px; filter:grayscale(1); opacity:.5; }
      [data-dir='c'] .marquee img { filter:grayscale(1) invert(1); }
      @keyframes scroll { to { transform:translateX(-50%); } }
      @media (prefers-reduced-motion:reduce){ .marquee .track { animation:none; } }

      figure.media img { border-radius:var(--radius); width:100%; }
      figure.media figcaption { margin-top:14px; font-size:12px; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); text-align:center; }
    </style>
  </head>

  <body>
    <nav class="switch">
      <a href="?dir=a" class={dir === 'a' ? 'on' : ''}>A — Soft Modern</a>
      <a href="?dir=b" class={dir === 'b' ? 'on' : ''}>B — Editorial</a>
      <a href="?dir=c" class={dir === 'c' ? 'on' : ''}>C — Dark Technical</a>
      <a href="/">← real site</a>
      <span>{layout.length} sections · full content, nothing trimmed</span>
    </nav>

    {
      layout.map((block: any) => {
        const { lead, accent } = splitAccent(block.heading)

        // hero ---------------------------------------------------------
        if (block.blockType === 'hero') {
          return (
            <section class="hero">
              <div class="wrap inner">
                {block.eyebrow && <span class="label">{block.eyebrow}</span>}
                <h1>
                  {lead}
                  {accent && <em> {accent}</em>}
                </h1>
                {block.subheading && <p class="intro">{block.subheading}</p>}
                {block.actions?.length > 0 && (
                  <div class="btns" style="margin-top:30px">
                    {block.actions.map((a: any) => (
                      <a class="btn" href={resolveHref(a.link)}>{a.link?.label}</a>
                    ))}
                  </div>
                )}
                {block.images?.length > 0 && (
                  <div class="hero-imgs">
                    {block.images.map((im: any) => (
                      <Picture media={im.image ?? im} />
                    ))}
                  </div>
                )}
              </div>
              {block.marqueeLogos?.length > 0 && (
                <div class="marquee">
                  <div class="track">
                    {[0, 1].map(() =>
                      block.marqueeLogos.map((l: any) => <Picture media={l.image ?? l} raw />),
                    )}
                  </div>
                </div>
              )}
            </section>
          )
        }

        // rich text ----------------------------------------------------
        if (block.blockType === 'richText') {
          return (
            <section>
              <div class="wrap">
                {block.eyebrow && <span class="label">{block.eyebrow}</span>}
                {block.heading && (
                  <h2 class="display" style="margin-bottom:26px">
                    {lead}
                    {accent && <em> {accent}</em>}
                  </h2>
                )}
                <div class="rt" set:html={lexicalToHtml(block.content)} />
              </div>
            </section>
          )
        }

        // feature grid -------------------------------------------------
        if (block.blockType === 'featureGrid') {
          return (
            <section>
              <div class="wrap">
                {block.eyebrow && <span class="label">{block.eyebrow}</span>}
                {block.heading && (
                  <h2 class="display">
                    {lead}
                    {accent && <em> {accent}</em>}
                  </h2>
                )}
                {block.intro && <p class="intro">{block.intro}</p>}
                <div class="grid">
                  {block.features?.map((f: any, i: number) => (
                    <div class="card">
                      <div class="n">{String(i + 1).padStart(2, '0')}</div>
                      <h3>{f.title}</h3>
                      {f.description && <p>{f.description}</p>}
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )
        }

        // process steps ------------------------------------------------
        if (block.blockType === 'processSteps') {
          return (
            <section>
              <div class="wrap">
                {block.eyebrow && <span class="label">{block.eyebrow}</span>}
                {block.heading && (
                  <h2 class="display">
                    {lead}
                    {accent && <em> {accent}</em>}
                  </h2>
                )}
                {block.intro && <p class="intro">{block.intro}</p>}
                <div class="steps">
                  {block.steps?.map((s: any, i: number) => (
                    <div class="step">
                      <div class="n">{String(i + 1).padStart(2, '0')}</div>
                      <div>
                        {s.meta && <span class="meta">{s.meta}</span>}
                        <h3>{s.title}</h3>
                        {s.description && <p>{s.description}</p>}
                      </div>
                    </div>
                  ))}
                </div>
                {block.footnote && <p class="intro">{block.footnote}</p>}
              </div>
            </section>
          )
        }

        // coverage -----------------------------------------------------
        if (block.blockType === 'coverage') {
          return (
            <section>
              <div class="wrap">
                {block.eyebrow && <span class="label">{block.eyebrow}</span>}
                {block.heading && (
                  <h2 class="display">
                    {lead}
                    {accent && <em> {accent}</em>}
                  </h2>
                )}
                {block.note && <p class="intro">{block.note}</p>}
                <div class="grid">
                  {block.areas?.map((a: any) => (
                    <div class="card">
                      <h3>{a.name}</h3>
                      {a.note && <p>{a.note}</p>}
                    </div>
                  ))}
                </div>
                <div class="rt" set:html={lexicalToHtml(block.content)} />
              </div>
            </section>
          )
        }

        // logo wall ----------------------------------------------------
        if (block.blockType === 'logoWall') {
          return (
            <section>
              <div class="wrap">
                {block.eyebrow && <span class="label">{block.eyebrow}</span>}
                {block.heading && (
                  <h2 class="display">
                    {lead}
                    {accent && <em> {accent}</em>}
                  </h2>
                )}
                {block.intro && <p class="intro">{block.intro}</p>}
                <div class="logos">
                  {block.logos?.map((l: any) => (
                    <div title={l.name}>
                      <Picture media={l.image} raw />
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )
        }

        // faq ----------------------------------------------------------
        if (block.blockType === 'faq') {
          return (
            <section>
              <div class="wrap">
                <span class="label">{block.eyebrow ?? 'Knowledge Base'}</span>
                {block.heading && (
                  <h2 class="display">
                    {lead}
                    {accent && <em> {accent}</em>}
                  </h2>
                )}
                {block.intro && <p class="intro">{block.intro}</p>}
                <div class="faq">
                  {block.items?.map((it: any) => (
                    <details>
                      <summary>{it.question}</summary>
                      <div class="rt" set:html={lexicalToHtml(it.answer)} />
                    </details>
                  ))}
                </div>
              </div>
            </section>
          )
        }

        // media --------------------------------------------------------
        if (block.blockType === 'media') {
          return (
            <section>
              <div class="wrap">
                <figure class="media">
                  <Picture media={block.media} />
                  {block.caption && <figcaption>{block.caption}</figcaption>}
                </figure>
              </div>
            </section>
          )
        }

        // cta ----------------------------------------------------------
        if (block.blockType === 'cta') {
          return (
            <section style="padding:40px 0">
              <div class="wrap">
                <div class="cta">
                  {block.eyebrow && <span class="label">{block.eyebrow}</span>}
                  <h3>
                    {lead}
                    {accent && <em> {accent}</em>}
                  </h3>
                  {block.body && <p>{block.body}</p>}
                  {block.actions?.length > 0 && (
                    <div class="btns">
                      {block.actions.map((a: any) => (
                        <a class="btn" href={resolveHref(a.link)}>{a.link?.label}</a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </section>
          )
        }

        // Any block type not handled above would be invisible, which is
        // exactly the failure mode we must not ship. Make it loud instead.
        return (
          <section>
            <div class="wrap">
              <p style="color:#fff;background:#B4141B;padding:14px 18px;border-radius:8px">
                Unstyled block type: <strong>{block.blockType}</strong> — needs a branch here.
              </p>
            </div>
          </section>
        )
      })
    }
  </body>
</html>
