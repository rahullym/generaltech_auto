# ---- Shared ----
DATABASE_URI=postgres://payload:payload@localhost:5434/gta

# ---- CMS (apps/cms) ----
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-long-random-string
# Public origin of the CMS itself (admin + API live here)
NEXT_PUBLIC_SERVER_URL=http://localhost:3010
# Origin of the Astro frontend, used for live preview + CORS
FRONTEND_URL=http://localhost:4331

# ---- Web (apps/web) ----
# Server-side base URL Astro uses to reach Payload
PAYLOAD_URL=http://localhost:3010
# Public canonical URL of the website
PUBLIC_SITE_URL=http://localhost:4331
# Shared secret Payload signs preview links with
PAYLOAD_PREVIEW_SECRET=replace-me-too
# API key of a Payload user, used by Astro to read drafts during preview.
# Create a user in the admin panel, tick "Enable API Key", paste it here.
PAYLOAD_API_KEY=

# Where contact-form submissions are delivered: any endpoint that accepts a
# JSON POST. Leave unset and the form composes the enquiry in the sender's own
# mail client instead.
CONTACT_WEBHOOK_URL=
