{
  "name": "generaltechautomation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:cms": "pnpm --filter cms dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter cms build && pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "generate:types": "pnpm --filter cms generate:types",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "pnpm --filter cms migrate"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
